# ============================================================
# VIETRAVEL AIRLINES CARGO BIDDING - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your actual credentials
# ============================================================

# --- SERVER CONFIGURATION ---
PORT=8085
NODE_ENV=development
BASE_URL=http://localhost:8085

# --- DATABASE CONFIGURATION ---
DB_TYPE=sqlite
DB_FILE=database.sqlite

# --- SMTP EMAIL SERVICE CONFIGURATION ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Vietravel Airlines Cargo
SMTP_FROM_EMAIL=ops-cargo@vietravelairlines.vn

# --- MOMO PAYMENT GATEWAY CONFIGURATION ---
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_IPN_URL=http://localhost:8085/api/momo/ipn
MOMO_REDIRECT_URL=http://localhost:8085/07-WonAuction.html

# --- SECURITY & AUTHENTICATION ---
SESSION_SECRET=change_this_to_a_random_secret_in_production
