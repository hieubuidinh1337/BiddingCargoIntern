            const allAuctions = CargoStore.getAuctions();
            const auction = allAuctions.find(a => String(a.id) === String(auctionId));
            if (!auction) {
                alert('Không tìm thấy thông tin gói thầu!');
                return;
            }

            if (!CargoStore.isAgentAllowedForAuction(auction, u.agentCode)) {
                alert('Đại lý của bạn không nằm trong danh sách đại lý được phê duyệt tham gia phiên đấu giá chuyến bay này!');
