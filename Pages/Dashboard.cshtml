                    alert(`✅ ĐÃ NỘP GIÁ THẦU THÀNH CÔNG CHO ${successCount} CHUYẾN BAY!\n\nTổng giá mua: ${CargoStore.formatCurrency(grandTotal)}\n\nPhiếu giá đã được hệ thống ghi nhận an toàn.`);
