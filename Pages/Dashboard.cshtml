        function onDashPriceInput(auctionId, capKg) {
            const input = document.getElementById('dashBidInput_' + auctionId);
            if (!input) return;
            const price = Math.max(0, Number(input.value) || 0);
            dashInputCache[auctionId] = price;

            const rowTotal = capKg * price;
            const rowEl = document.getElementById('dashRowTotal_' + auctionId);
            const formulaEl = document.getElementById('dashRowFormula_' + auctionId);
            if (rowEl) rowEl.textContent = CargoStore.formatCurrency(rowTotal);
            if (formulaEl) formulaEl.textContent = `=${CargoStore.formatNumber(capKg)} × ${CargoStore.formatNumber(price)}`;

            // Đang điền chưa xác nhận thì không cộng vào tổng giá đã đặt
            updateDashAllTotals();
        }

        // Tính tổng giá đã đặt: CHỈ cộng những chuyến bay đã bấm Xác nhận đặt giá
        function updateDashAllTotals() {
            const u = CargoStore.getCurrentUser();
            const myCode = u ? (u.agentCode || '') : '';
            const allAuctions = CargoStore.getAuctions();
            const openAuctions = allAuctions.filter(a => a.status === 'OPEN' && CargoStore.isAgentAllowedForAuction(a, myCode));
            const myBids = CargoStore.getMyBids ? CargoStore.getMyBids() : [];

            let grandTotal = 0;
            let confirmedCount = 0;

            openAuctions.forEach(a => {
                const auctionMyBids = (myBids || []).filter(b => String(b.auctionId) === String(a.id));
                const myHighestBid = auctionMyBids.length > 0
                    ? auctionMyBids.sort((x, y) => (Number(y.priceKg) || 0) - (Number(x.priceKg) || 0))[0]
                    : null;

                // Chỉ tính tổng cho các chuyến bay đã bấm Xác nhận nộp giá thầu
                if (myHighestBid) {
                    const capKg = a.capacityKg || 3500;
                    const price = Number(myHighestBid.priceKg) || 0;
                    grandTotal += (capKg * price);
                    confirmedCount++;
                }
            });

            const grandTotalEl = document.getElementById('dashGrandTotal');
            if (grandTotalEl) {
                grandTotalEl.textContent = CargoStore.formatCurrency(grandTotal);
            }
        }

        // Submit Bids for All Prepared (Selected) Sessions
        async function submitAllPreparedBids() {
            const u = CargoStore.getCurrentUser();
            if (!u) {
                alert('Vui lòng đăng nhập trước khi nộp giá thầu!');
                window.location.href = '01-Login.html';
                return;
            }

            const myCode = u ? (u.agentCode || '') : '';
            const allAuctions = CargoStore.getAuctions();
            const openAuctions = allAuctions.filter(a => a.status === 'OPEN' && CargoStore.isAgentAllowedForAuction(a, myCode));
            const myBids = CargoStore.getMyBids ? CargoStore.getMyBids() : [];

            const preparedList = [];
            for (const a of openAuctions) {
                const isSubmitted = (myBids || []).some(b => String(b.auctionId) === String(a.id));
                if (isSubmitted) continue;

                const input = document.getElementById('dashBidInput_' + a.id);
                if (!input || !input.value) continue;
                const startPrice = a.startingPriceKg || 18000;
                const priceKg = input ? Number(input.value) : (dashInputCache[a.id] || startPrice);
                const capKg = a.capacityKg || 3500;
                const minAcceptable = a.startingPriceKg || a.currentPriceKg || 0;
                if (!priceKg || priceKg < minAcceptable) {
                    alert(`Mức giá chuyến ${a.flightNumber} tối thiểu phải từ giá sàn: ${CargoStore.formatCurrency(minAcceptable)}/Kg trở lên!`);
                    if (input) input.focus();
                    return;
                }

                preparedList.push({
                    auction: a,
                    priceKg: priceKg,
                    capKg: capKg,
                    total: capKg * priceKg
                });
            }

            if (preparedList.length === 0) {
                alert('Vui lòng tích chọn ít nhất 1 chuyến bay chuẩn bị đặt giá thầu!');
                return;
            }

            const grandTotal = preparedList.reduce((sum, item) => sum + item.total, 0);
            const breakdownHtml = preparedList.map(item => `
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 7px 8px; border-bottom: 1px solid #f1f5f9; font-size: 12px;">
                    <div>
