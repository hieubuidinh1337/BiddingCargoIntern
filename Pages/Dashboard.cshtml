                    </div>

                    <!-- Total Banner -->
                    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); color: #ffffff; border-radius: 12px; padding: 12px 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);">
                        <div>
                            <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; font-weight: 600;">Tổng giá mua dự kiến</div>
                            <div style="font-size: 21px; font-weight: 800; letter-spacing: 0.5px; margin-top: 1px;">${CargoStore.formatCurrency(totalVnd)}</div>
                        </div>
                        <div style="font-size: 26px;">💰</div>
                    </div>

                    <!-- Rule Callout -->
                    <div style="background: #eff6ff; border: 1px solid #dbeafe; border-left: 4px solid #3b82f6; border-radius: 8px; padding: 10px 12px; font-size: 11.5px; color: #1e40af; line-height: 1.5; margin-bottom: 12px;">
                        <strong>ℹ️ QUY CHẾ ĐẶT GIÁ:</strong> Phiếu giá nộp sẽ được hệ thống mã hóa và ghi nhận ngay. Quý đại lý có thể nộp giá thầu hoặc nâng giá cao hơn bất kỳ lúc nào trước khi phiên đóng thầu.
                    </div>

                    <div style="text-align: center; font-size: 13px; font-weight: 600; color: #1e293b;">
                        Bạn có chắc chắn muốn nộp mức giá này?
                    </div>
                </div>
            `;

            let isOk = false;
            if (window.showConfirm) {
                isOk = await window.showConfirm({
                    title: 'Xác nhận nộp phiếu thầu',
                    html: singleModalHtml,
                    confirmText: 'Nộp giá thầu ngay',
                    cancelText: 'Kiểm tra lại',
                    icon: 'info'
                });
            } else {
                isOk = confirm(`Xác nhận nộp giá thầu cho chuyến ${flCode} với đơn giá ${CargoStore.formatCurrency(priceKg)}/Kg (Tổng: ${CargoStore.formatCurrency(totalVnd)})?`);
            }
            if (!isOk) return;

            const res = CargoStore.placeBid(auctionId, priceKg, true);
            if (res.success) {
                if (typeof Swal !== 'undefined') {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Nộp phiếu thầu thành công!',
                        html: `
                            <div style="text-align: left; font-family: inherit; margin-top: 4px;">
                                <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 12px; padding: 14px; margin-bottom: 12px;">
                                    <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 6px;">
                                        <span style="color: #065f46; font-weight: 600;">Chuyến bay:</span>
                                        <span style="color: #047857; font-weight: 700;">✈️ ${flCode} (${rtCode})</span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 6px;">
                                        <span style="color: #065f46; font-weight: 600;">Đơn giá nộp:</span>
                                        <span style="color: #047857; font-weight: 700;">${CargoStore.formatCurrency(priceKg)}/Kg</span>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; font-size: 14px; border-top: 1px dashed #6ee7b7; padding-top: 8px; margin-top: 2px;">
                                        <span style="color: #065f46; font-weight: 700;">Tổng thành tiền:</span>
                                        <span style="color: #047857; font-weight: 800; font-size: 17px;">${CargoStore.formatCurrency(totalVnd)}</span>
                                    </div>
                                </div>
                                <div style="font-size: 12px; color: #64748b; text-align: center; display: flex; align-items: center; justify-content: center; gap: 4px;">
                                    <span>🔒</span> Phiếu giá đã được hệ thống mã hóa và lưu trữ an toàn.
                                </div>
                            </div>
                        `,
                        confirmButtonText: 'Đã hoàn tất',
                        buttonsStyling: false,
                        customClass: {
                            popup: 'cargo-swal-popup',
                            confirmButton: 'cargo-swal-confirm-btn'
                        }
                    });
                } else {
                    alert(`✅ Đã nộp giá thầu thành công!\n\nChuyến bay: ${flCode}\nMức giá: ${CargoStore.formatCurrency(priceKg)}/Kg\nTổng thành tiền: ${CargoStore.formatCurrency(totalVnd)}\n\nPhiếu giá đã được lưu trữ an toàn.`);
                }
                delete dashInputCache[auctionId];
                delete dashCheckCache[auctionId];
                renderDashboard();
            } else {
                alert(res.message || 'Không thể gửi giá thầu!');
            }
        }

        // Backward compatibility
        window.submitBidDirect = submitBidSingle;
        window.updateDashCardTotal = onDashPriceInput;

        let isRenderingDashboard = false;
        function safeRenderDashboard() {
            if (isRenderingDashboard || (typeof document !== 'undefined' && document.hidden)) return;
            // Prevent auto-refresh from interrupting typing
            const activeEl = document.activeElement;
            if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'SELECT')) {
                return;
            }
            isRenderingDashboard = true;
            try {
                renderDashboard();
            } finally {
                isRenderingDashboard = false;
            }
        }

        function updateDashCountdowns() {
            if (typeof document !== 'undefined' && document.hidden) return;
            const timerEls = document.querySelectorAll('.dash-timer-text');
            let needsRefresh = false;

            timerEls.forEach(el => {
                const endTime = el.getAttribute('data-endtime');
                if (!endTime) return;
                const timer = CargoStore.getTimeRemaining(endTime);
                const valEl = el.querySelector('.timer-val');
                if (valEl) {
                    if (timer.total <= 0) {
                        valEl.textContent = 'Đã đóng thầu';
                        needsRefresh = true;
                    } else {
                        valEl.textContent = `Còn ${timer.hours > 0 ? timer.hours + 'h ' : ''}${timer.minutes}m ${timer.seconds}s`;
                    }
                }
            });

            if (needsRefresh) {
                safeRenderDashboard();
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            safeRenderDashboard();
            setInterval(updateDashCountdowns, 1000);
        });

        // Cross-browser & Cross-tab sync: when store updates, re-render safely
        let dashUpdateTimeout = null;
        function onStoreUpdate() {
            if (dashUpdateTimeout) clearTimeout(dashUpdateTimeout);
            dashUpdateTimeout = setTimeout(safeRenderDashboard, 100);
        }

        window.addEventListener('storage', function (e) {
            if (e.key === 'CARGO_BIDDING_DATA_V3') onStoreUpdate();
        });
        window.addEventListener('cargostore_updated', onStoreUpdate);
    </script>
</body>

</html>