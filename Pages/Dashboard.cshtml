@page
@model BiddingCargo.Web.Pages.DashboardModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sàn Đấu Giá Trực Tuyến - Cargo Bidding | Vietravel Airlines</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="assets/js/sweetalert2.all.min.js"></script>
    <script src="assets/js/cargo-store.js?v=20261014_01"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Exo:ital,wght@@0,100;0,200;0,300;0,400;0,500;0,531;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,531;1,600;1,700;1,800;1,900"
        rel="stylesheet" />
    <style>
        body,
        input,
        select,
        textarea,
        button {
            font-family: 'Exo', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- Top Navigation Bar for Agent -->
    <header class="bg-white border-b shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3 flex items-center justify-between">
            <div class="flex items-center gap-2.5 sm:gap-6">
                <!-- Mobile Menu Toggle Button -->
                <button type="button" onclick="toggleAgentMobileNav()"
                    class="md:hidden text-gray-600 hover:text-blue-600 p-1.5 rounded-xl hover:bg-gray-100 transition focus:outline-none"
                    aria-label="Menu">
                    <i class="fa-solid fa-bars text-base"></i>
                </button>

                <a href="02-Dashboard.html" class="flex items-center gap-2.5 shrink-0">
                    <img src="assets/images/vietravel-logo-doc.png" alt="Vietravel Airlines"
                        class="h-8 sm:h-9 object-contain" />
                    <span
                        class="font-bold text-sm sm:text-base text-slate-900 tracking-tight border-l border-slate-200 pl-2.5">Cargo
                        Bidding</span>
                </a>
                <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
                    <a href="02-Dashboard.html"
                        class="px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-gavel text-xs"></i> Sàn đấu giá trực tuyến
                    </a>
                    <a href="06-MyBids.html"
                        class="px-3 py-1.5 rounded-lg text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-clock-rotate-left text-xs"></i> Lịch sử thầu
                    </a>
                    <a href="07-WonAuction.html"
                        class="px-3 py-1.5 rounded-lg text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-trophy text-xs"></i> Thắng thầu
                    </a>
                </nav>
            </div>

            <!-- Right Actions: Notifications & Profile -->
            <div class="flex items-center gap-1.5 sm:gap-3">
                <a href="08-Notifications.html"
                    class="relative p-1.5 sm:p-2 text-gray-500 hover:text-blue-600 rounded-xl hover:bg-gray-100 transition"
                    title="Thông báo">
                    <i class="fa-solid fa-bell text-base sm:text-lg"></i>
                    <span id="headerNotifDot"
                        class="absolute top-1 sm:top-1.5 right-1 sm:right-1.5 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white animate-pulse"></span>
                </a>

                <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>

                <a href="09-Profile.html"
                    class="flex items-center gap-2 hover:bg-gray-50 p-1 sm:p-1.5 rounded-xl transition">
                    <div id="hdrAvatar"
                        class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs">
                        AG
                    </div>
                    <div class="hidden sm:block text-left">
                        <p id="hdrCompany"
                            class="text-xs font-bold text-slate-800 leading-tight truncate max-w-[120px]">ABC Logistics
                        </p>
                        <p class="text-[11px] text-gray-500 leading-none">Mã: <span id="hdrCode"
                                class="text-blue-600 font-semibold font-mono"></span></p>
                    </div>
                </a>

                <a href="01-Login.html" onclick="if(window.CargoStore) CargoStore.logoutAgent()" title="Đăng xuất"
                    class="text-gray-400 hover:text-red-600 p-1.5 sm:p-2 transition">
                    <i class="fa-solid fa-right-from-bracket text-sm sm:text-base"></i>
                </a>
            </div>
        </div>

        <!-- Mobile Navigation Menu Dropdown -->
        <div id="agentMobileNav"
            class="hidden md:hidden bg-white border-t px-4 py-2.5 space-y-1 text-xs font-medium shadow-lg">
            <a href="02-Dashboard.html"
                class="flex items-center gap-2 px-3 py-2 rounded-lg bg-blue-50 text-blue-600 font-semibold">
                <i class="fa-solid fa-gavel w-4"></i> Sàn đấu giá trực tuyến
            </a>
            <a href="06-MyBids.html"
                class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50 hover:text-blue-600 transition">
                <i class="fa-solid fa-clock-rotate-left w-4"></i> Lịch sử đặt thầu
            </a>
            <a href="07-WonAuction.html"
                class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50 hover:text-blue-600 transition">
                <i class="fa-solid fa-trophy w-4"></i> Đơn hàng thắng thầu
            </a>
            <a href="08-Notifications.html"
                class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50 hover:text-blue-600 transition">
                <i class="fa-solid fa-bell w-4"></i> Trung tâm thông báo
            </a>
            <a href="09-Profile.html"
                class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-700 hover:bg-gray-50 hover:text-blue-600 transition">
                <i class="fa-solid fa-user-shield w-4"></i> Hồ sơ đại lý & Mã PIN
            </a>
            <a href="10-Terms.html"
                class="flex items-center gap-2 px-3 py-2 rounded-lg text-gray-500 hover:bg-gray-50 hover:text-gray-800 transition border-t pt-2 mt-1">
                <i class="fa-solid fa-file-contract w-4"></i> Quy chế & Điều khoản
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 space-y-4 sm:space-y-6">

        <!-- PIN Setup Reminder Banner (only shown if agent has no PIN) -->
        <div id="pinReminderBanner"
            class="hidden bg-gradient-to-r from-amber-500/10 via-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
            <div class="flex items-start sm:items-center gap-3">
                <div
                    class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 text-base shadow-sm">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 text-xs sm:text-sm flex items-center gap-2">
                        Thiết lập Mã PIN bảo mật (4 chữ số)
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">Khuyến
                            nghị bảo mật</span>
                    </h4>
                    <p class="text-xs text-slate-600 mt-0.5">
                        Tài khoản của bạn chưa tạo mã PIN. Hãy thiết lập ngay để tăng cường bảo mật và ủy quyền giao
                        dịch đấu giá nhanh chóng.
                    </p>
                </div>
            </div>
            <a href="09-Profile.html#pinSecurityCard"
                class="shrink-0 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition shadow flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-key"></i> Thiết lập PIN ngay
            </a>
        </div>

        <!-- 3 KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
            <div
                class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-5 border shadow-sm flex items-center gap-3.5 sm:gap-4">
                <div
                    class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg sm:text-xl shrink-0">
                    <i class="fa-solid fa-plane-departure"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs text-gray-500 font-medium">Phiên đang mở thầu</p>
                    <p id="kpiOpenSessions" class="text-xl sm:text-2xl font-bold text-slate-900 mt-0.5">0</p>
                    <span class="text-[11px] text-green-600 font-semibold block truncate">Hôm nay sẵn sàng đấu
                        giá</span>
                </div>
            </div>

            <div
                class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-5 border shadow-sm flex items-center gap-3.5 sm:gap-4">
                <div
                    class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg sm:text-xl shrink-0">
                    <i class="fa-solid fa-gavel"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs text-gray-500 font-medium">Gói thầu đã tham gia</p>
                    <p id="kpiLeading" class="text-xl sm:text-2xl font-bold text-blue-600 mt-0.5 truncate">0 <span
                            class="text-xs text-gray-400 font-normal">chuyến</span></p>
                </div>
            </div>

            <div
                class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-5 border shadow-sm flex items-center gap-3.5 sm:gap-4">
                <div
                    class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg sm:text-xl shrink-0">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-xs text-gray-500 font-medium">Đã trúng thầu</p>
                    <p id="kpiWon" class="text-xl sm:text-2xl font-bold text-emerald-600 mt-0.5 truncate">0 <span
                            class="text-xs text-gray-400 font-normal">đơn</span></p>
                </div>
            </div>
        </div>

        <!-- Main Auctions Section (Full Width, Excel Layout) -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-1">
                <!-- <div>
                    <h3 class="font-bold text-lg text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-file-excel text-emerald-600"></i> Danh sách gói thầu tải trọng đang mở
                    </h3>
                    <p class="text-xs text-slate-500 mt-0.5">
                        Bảng thông tin đăng ký gói thầu theo mẫu biểu: Cam kết sản lượng tối thiểu & Đơn giá
                        cước vận chuyển.
                    </p>
                </div> -->

                <!-- Bộ lọc theo giai đoạn bay: Từ ngày -> Đến ngày -->
                <div
                    class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-2xs text-xs flex-wrap">
                    <span class="text-slate-600 font-semibold flex items-center gap-1">
                        <i class="fa-regular fa-calendar-days text-blue-600"></i> Giai đoạn bay:
                    </span>
                    <div class="flex items-center gap-1.5">
                        <input type="date" id="dashFilterFromDate" onchange="applyDashDateFilter()"
                            class="border border-slate-200 rounded-lg px-2 py-1 text-xs font-medium outline-none focus:border-blue-500 bg-slate-50 focus:bg-white text-slate-700"
                            title="Từ ngày">
                        <span class="text-slate-400 font-bold">➔</span>
                        <input type="date" id="dashFilterToDate" onchange="applyDashDateFilter()"
                            class="border border-slate-200 rounded-lg px-2 py-1 text-xs font-medium outline-none focus:border-blue-500 bg-slate-50 focus:bg-white text-slate-700"
                            title="Đến ngày">
                        <button type="button" onclick="clearDashDateFilter()" title="Xóa bộ lọc ngày"
                            class="text-slate-400 hover:text-slate-700 px-1.5 py-1 text-xs cursor-pointer">
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- List of Excel-style Auction Cards -->
            <div id="dashboardAuctionList" class="space-y-4">
                <!-- Rendered by JS -->
            </div>
            <div id="dashAuctionPagination"></div>
        </div>

    </main>

    <script>
        function toggleAgentMobileNav() {
            const nav = document.getElementById('agentMobileNav');
            if (nav) nav.classList.toggle('hidden');
        }

        let dashAuctionCurrentPage = 1;
        const dashAuctionPageSize = 20;
        const dashInputCache = {};
        const dashCheckCache = {};
        let dashFilterFrom = '';
        let dashFilterTo = '';

        function applyDashDateFilter() {
            dashFilterFrom = document.getElementById('dashFilterFromDate')?.value || '';
            dashFilterTo = document.getElementById('dashFilterToDate')?.value || '';
            dashAuctionCurrentPage = 1;
            renderDashboard();
        }

        function clearDashDateFilter() {
            dashFilterFrom = '';
            dashFilterTo = '';
            const f1 = document.getElementById('dashFilterFromDate');
            const f2 = document.getElementById('dashFilterToDate');
            if (f1) f1.value = '';
            if (f2) f2.value = '';
            dashAuctionCurrentPage = 1;
            renderDashboard();
        }

        function goToDashAuctionPage(page) {
            dashAuctionCurrentPage = page;
            renderDashboard();
        }

        function renderDashboard() {
            if (typeof CargoStore === 'undefined') return;

            const u = CargoStore.getCurrentUser();
            const myCode = u ? (u.agentCode || '') : '';
            const allAuctions = CargoStore.getAuctions();
            let openAuctions = allAuctions.filter(a => a.status === 'OPEN' && CargoStore.isAgentAllowedForAuction(a, myCode));

            // Filter by date range (Giai đoạn bay)
            if (dashFilterFrom) {
                openAuctions = openAuctions.filter(a => {
                    const fStart = a.flightStartDate || (a.etdIso ? a.etdIso.slice(0, 10) : '');
                    const fEnd = a.flightEndDate || fStart;
                    return !fEnd || fEnd >= dashFilterFrom;
                });
            }
            if (dashFilterTo) {
                openAuctions = openAuctions.filter(a => {
                    const fStart = a.flightStartDate || (a.etdIso ? a.etdIso.slice(0, 10) : '');
                    return !fStart || fStart <= dashFilterTo;
                });
            }

            // === Update Header Profile ===
            if (u) {
                const hdrCompany = document.getElementById('hdrCompany');
                const hdrCode = document.getElementById('hdrCode');
                const hdrAvatar = document.getElementById('hdrAvatar');
                if (hdrCompany) hdrCompany.textContent = u.companyName || 'Đại lý';
                if (hdrCode) hdrCode.textContent = u.agentCode || 'AG-xxxx';
                if (hdrAvatar) hdrAvatar.textContent = (u.agentCode || 'AG').slice(0, 2);
                if (document.getElementById('dashWelcomeName')) document.getElementById('dashWelcomeName').textContent = `Xin chào, ${u.fullName || 'Đại lý'}`;
                if (document.getElementById('dashCompanyInfo')) document.getElementById('dashCompanyInfo').innerHTML = `${u.companyName} (${u.agentCode}) · Hôm nay có <strong>${openAuctions.length} chuyến bay</strong> mở thầu tải trọng cargo.`;
                if (document.getElementById('dashTierLabel')) document.getElementById('dashTierLabel').textContent = 'Đại lý ủy quyền chính thức';

                // Check PIN status and show reminder banner if missing
                const pinBanner = document.getElementById('pinReminderBanner');
                if (pinBanner) {
                    const storeData = (typeof CargoStore !== 'undefined' && CargoStore.getData) ? CargoStore.getData() : null;
                    const agentObj = storeData && storeData.agentsList ? storeData.agentsList.find(a => (a.code || '').toUpperCase() === (u.agentCode || '').toUpperCase()) : null;
                    const hasPin = Boolean(u.pin || (agentObj && agentObj.pin));

                    if (!hasPin) {
                        pinBanner.classList.remove('hidden');
                    } else {
                        pinBanner.classList.add('hidden');
                    }
                }
            }

            // === Update Notification Dot (Bell Badge) ===
            const notifDot = document.getElementById('headerNotifDot');
            if (notifDot) {
                const allNotifs = (CargoStore.getNotifications ? CargoStore.getNotifications() : []).filter(n => {
                    if (!n) return false;
                    const t = (n.title || '').toUpperCase();
                    const m = (n.message || '').toUpperCase();
                    return !(t.includes('THANH TOÁN') || t.includes('CHUYỂN KHOẢN') || m.includes('THANH TOÁN') || m.includes('CHUYỂN KHOẢN') || n.type === 'PAYMENT_REMINDER' || n.type === 'PAYMENT');
                });
                const unreadCount = allNotifs.filter(n => !n.read).length;
                notifDot.style.display = unreadCount > 0 ? 'block' : 'none';
            }

            // === KPI 1: Phiên đang mở ===
            const kpiOpen = document.getElementById('kpiOpenSessions');
            if (kpiOpen) kpiOpen.textContent = openAuctions.length;

            // === KPI 2: Đã đặt thầu (Đang tham gia) ===
            const myBids = CargoStore.getMyBids ? CargoStore.getMyBids() : [];
            const openAuctionIds = new Set(openAuctions.map(a => String(a.id)));
            const myParticipatingAuctionIds = new Set(
                myBids.filter(b => openAuctionIds.has(String(b.auctionId))).map(b => String(b.auctionId))
            );
            const participatingCount = myParticipatingAuctionIds.size;
            const kpiLeading = document.getElementById('kpiLeading');
            if (kpiLeading) kpiLeading.innerHTML = `${participatingCount} <span class="text-xs text-gray-400 font-normal">chuyến</span>`;

            // === KPI 3: Thắng thầu (tính từ dữ liệu thực) ===
            const wonAuctions = CargoStore.getWonAuctions ? CargoStore.getWonAuctions() : [];
            const kpiWon = document.getElementById('kpiWon');
            if (kpiWon) kpiWon.innerHTML = `${wonAuctions.length} <span class="text-xs text-gray-400 font-normal">đơn</span>`;

            // === Render Featured Open Auctions (Unified Excel Bidding Sheet) ===
            const totalOpen = openAuctions.length;
            const container = document.getElementById('dashboardAuctionList');
            const pagContainer = document.getElementById('dashAuctionPagination');
            if (pagContainer) pagContainer.innerHTML = '';

            if (container) {
                if (totalOpen === 0) {
                    container.innerHTML = `<div class="p-8 text-center text-gray-400 text-sm bg-white rounded-2xl border">Hiện chưa có phiên đấu giá nào đang mở.</div>`;
                } else {
                    let endStr = '15/10/2026';
                    let startStr = '13/10/2026';
                    try {
                        const firstWithEnd = openAuctions.find(a => a.endTime);
                        if (firstWithEnd) {
                            const ed = new Date(firstWithEnd.endTime);
                            endStr = ed.toLocaleDateString('vi-VN');
                            const sd = firstWithEnd.createdAt ? new Date(firstWithEnd.createdAt) : new Date(ed.getTime() - 2 * 86400000);
                            startStr = sd.toLocaleDateString('vi-VN');
                        }
                    } catch (err) { }

                    const tableRowsHtml = openAuctions.map(a => {
                        const timer = CargoStore.getTimeRemaining(a.endTime);
                        const auctionMyBids = (myBids || []).filter(b => String(b.auctionId) === String(a.id));
                        const myHighestBid = auctionMyBids.length > 0
                            ? auctionMyBids.sort((x, y) => (Number(y.priceKg) || 0) - (Number(x.priceKg) || 0))[0]
                            : null;

                        const capKg = a.capacityKg || 3500;
                        const startPrice = a.startingPriceKg || 18000;
                        const isSubmitted = !!myHighestBid;
                        const currentPrice = isSubmitted
                            ? myHighestBid.priceKg
                            : (dashInputCache[a.id] !== undefined ? dashInputCache[a.id] : startPrice);
                        const rowTotal = capKg * currentPrice;

                        return `
                            <tr class="hover:bg-blue-50/30 transition">
                                <td class="py-3.5 px-4 border-r border-slate-200">
                                    <div class="flex items-start gap-2.5">
                                        ${isSubmitted ? `
                                            <span class="mt-0.5 text-emerald-600 text-sm shrink-0" title="Đã xác nhận đặt giá"><i class="fa-solid fa-circle-check"></i></span>
                                        ` : `
                                            <span class="mt-0.5 text-slate-400 text-xs shrink-0" title="Chưa xác nhận đặt giá"><i class="fa-solid fa-plane-departure"></i></span>
                                        `}
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="font-bold text-slate-900 text-sm font-mono bg-blue-50 text-blue-800 px-2 py-0.5 rounded border border-blue-200">${a.flightNumber}</span>
                                                <span class="text-slate-600 font-semibold text-xs">(${a.route})</span>
                                            </div>
                                            <div class="text-[11px] text-slate-500 mt-1 space-y-0.5">
                                                <p>${a.originName || a.origin} ➔ ${a.destName || a.destination}</p>
                                                ${a.flightPeriod ? `
                                                    <div class="flex items-center gap-1.5 text-blue-700 font-semibold py-0.5">
                                                        <i class="fa-regular fa-calendar-days text-blue-600"></i>
                                                        <span>Giai đoạn bay: <strong>${a.flightPeriod}</strong></span>
                                                    </div>
                                                ` : ''}
                                                <div class="flex items-center gap-2 flex-wrap">
                                                    <span>ETD: <strong>${a.etd}</strong></span>
                                                    <span>·</span>
                                                    <span class="dash-timer-text text-amber-600 font-semibold" data-endtime="${a.endTime}">
                                                        <i class="fa-regular fa-clock mr-0.5"></i><span class="timer-val">Còn ${timer.hours > 0 ? timer.hours + 'h ' : ''}${timer.minutes}m ${timer.seconds}s</span>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 border-r border-slate-200">
                                    <span class="font-bold text-slate-900 text-sm">${CargoStore.formatNumber(capKg)} KG</span>  
                                </td>
                                <td class="py-3.5 px-4 border-r border-slate-200">
                                    ${isSubmitted ? `
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-bold text-blue-700 text-base">${CargoStore.formatCurrency(myHighestBid.priceKg)}</span>
                                        </div>                                        
                                    ` : `
                                        <div class="flex items-center gap-1.5">
                                            <input type="number" 
                                                   id="dashBidInput_${a.id}" 
                                                   value="${currentPrice}" 
                                                   min="${startPrice}" 
                                                   step="${a.minStep || 500}" 
                                                   oninput="onDashPriceInput(${a.id}, ${capKg})" 
