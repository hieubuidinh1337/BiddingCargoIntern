                        <span style="color: #64748b; font-size: 11px; margin-left: 4px;">(${item.auction.route})</span>
                        <div style="color: #64748b; font-size: 11px;">${CargoStore.formatNumber(item.capKg)} KG × ${CargoStore.formatCurrency(item.priceKg)}/Kg</div>
                    </div>
                    <div style="font-weight: 700; color: #059669;">
                        ${CargoStore.formatCurrency(item.total)}
                    </div>
                </div>
            `).join('');

            const bulkModalHtml = `
                <div style="text-align: left; font-family: inherit;">
                    <div style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 12px 16px; border-radius: 12px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 12px rgba(37,99,235,0.25);">
                        <div>
                            <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.85; font-weight: 600;">Đơn vị dự thầu</span>
                            <div style="font-size: 14px; font-weight: 700; margin-top: 1px;">${u.companyName || u.fullName}</div>
                        </div>
                        <div style="text-align: right;">
                            <span style="font-size: 11px; opacity: 0.85; font-weight: 500;">Số lượng</span>
                            <div style="font-size: 15px; font-weight: 800; background: rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 6px; margin-top: 2px;">${preparedList.length} chuyến</div>
                        </div>
                    </div>

                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; max-height: 180px; overflow-y: auto; margin-bottom: 12px; padding: 4px 6px;">
                        ${breakdownHtml}
                    </div>

                    <div style="background: linear-gradient(135deg, #059669 0%, #047857 100%); color: #ffffff; border-radius: 12px; padding: 12px 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);">
                        <div>
                            <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; font-weight: 600;">Tổng giá mua dự kiến (${preparedList.length} chuyến)</div>
                            <div style="font-size: 20px; font-weight: 800; letter-spacing: 0.5px; margin-top: 1px;">${CargoStore.formatCurrency(grandTotal)}</div>
                        </div>
                        <div style="font-size: 24px;">💰</div>
                    </div>

                    <div style="background: #fffbeb; border: 1px solid #fef3c7; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 9px 12px; font-size: 11.5px; color: #92400e; line-height: 1.45; margin-bottom: 12px;">
                        <strong>⚠️ LƯU Ý QUY CHẾ:</strong> Mỗi đại lý chỉ được nộp giá <strong>1 LẦN DUY NHẤT</strong> cho mỗi gói thầu. Phiếu giá sau khi gửi sẽ được ghi nhận ngay và <strong>KHÔNG THỂ</strong> thay đổi hay hủy bỏ.
                    </div>

                    <div style="text-align: center; font-size: 13px; font-weight: 600; color: #1e293b;">
                        Bạn có chắc chắn muốn nộp giá cho ${preparedList.length} chuyến bay này?
                    </div>
                </div>
            `;

            let isOk = false;
            if (window.showConfirm) {
                isOk = await window.showConfirm({
                    title: 'Xác nhận nộp phiếu thầu nhiều chuyến',
                    html: bulkModalHtml,
                    confirmText: 'Nộp tất cả phiếu giá',
                    cancelText: 'Kiểm tra lại',
