    <script>
        async function openProofImageInNewTab(imageUrl) {
            if (!imageUrl) return;

            let finalUrl = String(imageUrl).trim();
            if (!finalUrl) return;

            if (finalUrl.startsWith('data:image/')) {
                try {
                    const response = await fetch(finalUrl);
                    const blob = await response.blob();
                    finalUrl = URL.createObjectURL(blob);
                } catch (err) {
                    console.error('Failed to convert proof image data URL:', err);
                    return;
                }
            }

            const a = document.createElement('a');
            a.href = finalUrl;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            document.body.appendChild(a);
            a.click();
            a.remove();

            if (finalUrl.startsWith('blob:')) {
                setTimeout(() => URL.revokeObjectURL(finalUrl), 15000);
            }
        }

        async function openDocumentInNewTab(docUrl, docName) {
            if (!docUrl) return;
            let finalUrl = String(docUrl).trim();
            if (!finalUrl) return;
            const name = docName || 'chung_tu';
            try {
                if (finalUrl.startsWith('data:')) {
                    const response = await fetch(finalUrl);
                    const blob = await response.blob();
                    finalUrl = URL.createObjectURL(blob);
                }
                const w = window.open();
                if (w) {
                    const ext = (name.split('.').pop() || '').toLowerCase();
                    if (['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(ext)) {
                        w.document.write(`<html><head><title>${name}</title><style>body{margin:0;background:#111;display:flex;justify-content:center;align-items:flex-start;min-height:100vh;}img{max-width:100%;height:auto;margin:auto;display:block;}</style></head><body><img src="${finalUrl}" alt="${name}"/></body></html>`);
                    } else {
                        w.document.write(`<html><head><title>${name}</title><style>body,html{margin:0;padding:0;height:100%;}embed{width:100%;height:100%;}</style></head><body><embed src="${finalUrl}" type="application/pdf" width="100%" height="100%"/></body></html>`);
                    }
                    w.document.close();
                    if (finalUrl.startsWith('blob:')) setTimeout(() => URL.revokeObjectURL(finalUrl), 30000);
                }
            } catch (err) {
                console.error('openDocumentInNewTab error:', err);
            }
        }

        function toggleAdminMobileNav() {
            const nav = document.getElementById('adminMobileNav');
            if (nav) nav.classList.toggle('hidden');
        }

        function getParam(param) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param) || '1';
        }

        let currentAuction = null;
        let reviewTimerInterval = null;
        let currentBidsPage = 1;
        let bidsItemsPerPage = 10;

        window.changeBidsItemsPerPage = function (val) {
            bidsItemsPerPage = Number(val) || 10;
            currentBidsPage = 1;
            loadAdminDetail();
        };

        window.setBidsPage = function (p) {
            currentBidsPage = p;
            loadAdminDetail();
        };

        window.handleDetailCloseAuction = async function () {
            if (!currentAuction) return;
            const currentAdmin = CargoStore.getCurrentAdmin ? CargoStore.getCurrentAdmin() : {};
            const canClose = (CargoStore.hasPermission && CargoStore.hasPermission('auctions.close', currentAdmin)) ||
                (CargoStore.hasSettlementRole && CargoStore.hasSettlementRole(currentAdmin));
            if (!canClose) {
                if (window.Swal) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Từ chối quyền truy cập',
                        text: 'Tài khoản của bạn không có quyền Chốt phiên đấu giá (auctions.close)!'
                    });
                } else {
                    alert('Quyền bị từ chối: Thao tác Chốt phiên cần quyền auctions.close!');
                }
                return;
            }

            const flight = currentAuction.flightNumber || 'chuyến bay';
            const sysSettings = CargoStore.getSystemSettings ? CargoStore.getSystemSettings() : {};
            const configReviewMins = Number(sysSettings.reviewWindowMinutes) || 15;
            const bids = CargoStore.getBidsForAuction ? CargoStore.getBidsForAuction(currentAuction.id) : [];
            const uniqueAgentCodes = Array.from(new Set(bids.map(b => (b.agentCode || '').toUpperCase()).filter(Boolean)));
            const isSingleAgent = uniqueAgentCodes.length <= 1;

            const modalHtml = isSingleAgent ? `
                <div class="text-left text-xs space-y-2.5 pt-1">
                    <div class="p-3 bg-blue-50 border border-blue-200 rounded-xl text-blue-950 leading-relaxed">
                        <i class="fa-solid fa-circle-info text-blue-600 mr-1"></i>
                        Bạn có chắc chắn muốn chốt đóng phiên chuyến bay <strong>${flight}</strong> (${currentAuction.route})?
                    </div>
                    <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-950 space-y-1">
                        <p class="font-bold text-emerald-900"><i class="fa-solid fa-circle-check text-emerald-600 mr-1"></i>Chỉ có 1 đại lý tham gia đặt giá</p>
                        <p class="text-emerald-800">Hệ thống sẽ tự động xác nhận và chốt thầu chính thức ngay cho đại lý này.</p>
                    </div>
                </div>
            ` : `
                <div class="text-left text-xs space-y-2.5 pt-1">
                    <div class="p-3 bg-blue-50 border border-blue-200 rounded-xl text-blue-950 leading-relaxed">
                        <i class="fa-solid fa-circle-info text-blue-600 mr-1"></i>
                        Bạn có chắc chắn muốn chốt đóng phiên chuyến bay <strong>${flight}</strong> (${currentAuction.route})?
                    </div>
                    <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-900 space-y-1.5 leading-relaxed">
                        <p>✓ Tự động xác nhận đại lý có mức giá đặt cao nhất trúng thầu.</p>
                        <p>✓ Thời gian điều chỉnh: <strong>${configReviewMins} phút</strong> (theo cấu hình hệ thống). Trong thời gian điều chỉnh, cho phép thay đổi đại lý nếu không hoàn tất nghĩa vụ sau trúng thầu.</p>
                    </div>
                </div>
            `;

            const ok = window.Swal ? (await Swal.fire({
                title: 'Xác nhận chốt phiên đấu giá?',
                html: modalHtml,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fa-solid fa-gavel"></i> Chốt phiên ngay',
                confirmButtonColor: '#2563eb',
                cancelButtonText: 'Xem lại'
            })).isConfirmed : confirm('Bạn có chắc chắn muốn chốt đóng phiên chuyến bay ' + flight + '?');

            if (ok) {
                const res = CargoStore.closeAuction(currentAuction.id);
                if (res.success) {
                    if (window.Swal) {
                        await Swal.fire({
                            icon: 'success',
                            title: 'Chốt phiên thành công!',
                            text: res.message || 'Đã tự động xác nhận đại lý cao nhất!'
                        });
                    } else {
                        alert(res.message || 'Đã chốt phiên thành công!');
                    }
                    loadAdminDetail();
                } else {
                    alert(res.message || 'Không thể chốt phiên.');
                }
            }
        };

        function renderLeaderboardTable(auction, isStaff) {
            const lbody = document.getElementById('leaderboardBody');
            const summaryBadge = document.getElementById('leaderboardSummaryBadge');
            const reviewBanner = document.getElementById('reviewWindowBanner');
            const historyBox = document.getElementById('fallbackHistoryAlert');
            const auditTrailBox = document.getElementById('rejectAuditTrailSection');
            const tableWrapper = document.getElementById('leaderboardTableWrapper');
            const noticeWrapper = document.getElementById('leaderboardNoticeWrapper');
            if (!lbody) return;

            const list = CargoStore.getAuctionLeaderboard ? CargoStore.getAuctionLeaderboard(auction.id) : [];
            const isOpen = auction.status === 'OPEN';
            const canReview = CargoStore && CargoStore.isReviewPeriodActive ? CargoStore.isReviewPeriodActive(auction) : false;
            const isLocked = !canReview;
            const currentAdmin = CargoStore.getCurrentAdmin ? CargoStore.getCurrentAdmin() : {};
            const hasSettlement = Boolean((CargoStore.hasPermission && CargoStore.hasPermission('auctions.settle_select_winner', currentAdmin)) ||
                (CargoStore.hasSettlementRole && CargoStore.hasSettlementRole(currentAdmin)));

            // 1. TRƯỜNG HỢP: ĐANG TRONG QUÁ TRÌNH ĐẤU GIÁ (status === 'OPEN')
            // Quy tắc: Khi trong quá trình đấu giá thì Admin không xem được, ẩn hết
            if (isOpen) {
                if (summaryBadge) {
                    summaryBadge.className = 'text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-3 py-1 rounded-full inline-flex items-center gap-1.5 whitespace-nowrap shadow-2xs';
                    summaryBadge.innerHTML = '<i class="fa-solid fa-lock text-[11px] text-blue-500"></i> Đang bảo mật trong phiên';
                }
                if (reviewBanner) reviewBanner.classList.add('hidden');
                if (historyBox) historyBox.classList.add('hidden');
                if (auditTrailBox) auditTrailBox.classList.add('hidden');

                if (tableWrapper) tableWrapper.classList.add('hidden');
                if (noticeWrapper) {
                    noticeWrapper.classList.remove('hidden');
                    noticeWrapper.innerHTML = `
                        <div class="p-8 text-center bg-slate-50 border border-dashed border-slate-300 rounded-2xl space-y-3">
                            <div class="w-14 h-14 mx-auto rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center text-2xl shadow-xs">
                                <i class="fa-solid fa-user-secret"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Chính Sách Đấu Giá Kín Đang Áp Dụng</h4>
                                <p class="text-xs text-slate-500 max-w-lg mx-auto mt-1 leading-relaxed">
                                    Trong suốt thời gian phiên đấu giá đang diễn ra trực tiếp, toàn bộ danh sách đại lý tham gia, số tiền chào thầu và bảng xếp hạng được bảo mật tuyệt đối nhằm bảo đảm tính công bằng và minh bạch.
                                </p>
                            </div>
                            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-blue-50 border border-blue-200 rounded-full text-xs font-semibold text-blue-800">
                                <i class="fa-solid fa-lock text-blue-600"></i> Bảng tổng kết xếp hạng & kết quả sẽ được công bố sau khi phiên đấu giá kết thúc.
                            </div>
                        </div>
                    `;
                }
                return;
            }

            // 2. TRƯỜNG HỢP: PHIÊN ĐÃ ĐÓNG (status !== 'OPEN') MÀ KHÔNG CÓ ĐẠI LÝ NÀO ĐẶT GIÁ
            // Quy tắc: Phiên nào đóng rồi mà không có đại lý đặt giá thì bảng tổng kết xếp hạng ẩn
            if (list.length === 0) {
                if (summaryBadge) {
                    summaryBadge.className = 'text-xs font-semibold text-slate-600 bg-slate-100 border border-slate-200 px-3 py-1 rounded-full inline-flex items-center gap-1.5 whitespace-nowrap shadow-2xs';
                    summaryBadge.innerHTML = '<i class="fa-solid fa-users text-[11px] text-slate-400"></i> 0 đại lý tham gia';
                }
                if (reviewBanner) reviewBanner.classList.add('hidden');
                if (historyBox) historyBox.classList.add('hidden');
                if (auditTrailBox) auditTrailBox.classList.add('hidden');

                if (tableWrapper) tableWrapper.classList.add('hidden');
                if (noticeWrapper) {
                    noticeWrapper.classList.remove('hidden');
                    noticeWrapper.innerHTML = `
                        <div class="p-8 text-center bg-slate-50 border border-slate-200 rounded-2xl space-y-2">
                            <i class="fa-solid fa-inbox text-3xl text-slate-300 block mb-1"></i>
                            <h4 class="font-bold text-slate-700 text-sm">Phiên đấu giá đã kết thúc</h4>
                            <p class="text-xs text-slate-500 max-w-md mx-auto">
                                Phiên đấu giá đã đóng nhưng không có đại lý nào tham gia đặt giá. Bảng tổng kết xếp hạng được ẩn.
                            </p>
                            <span class="inline-block mt-1 px-3 py-1 bg-slate-100 text-slate-600 text-[11px] font-semibold rounded-full border border-slate-200">
                                0 lượt đặt giá · Không có người trúng thầu
                            </span>
                        </div>
                    `;
                }
                return;
            }

            // 3. TRƯỜNG HỢP: PHIÊN ĐÃ ĐÓNG VÀ CÓ ĐẠI LÝ ĐẶT GIÁ -> HIỂN THỊ BẢNG XẾP HẠNG
            if (noticeWrapper) noticeWrapper.classList.add('hidden');
            if (tableWrapper) tableWrapper.classList.remove('hidden');

            // Kiểm tra số lượng đại lý thực tế tham gia: nếu chỉ có 1 đại lý thì auto confirm vì chỉ có 1 đại lý
            const uniqueAgents = Array.from(new Set(list.map(b => (b.agentCode || '').toUpperCase()).filter(Boolean)));
            const isSingleAgent = uniqueAgents.length <= 1;

            if (summaryBadge) {
                if (isSingleAgent && list.length > 0) {
                    summaryBadge.className = 'text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-300 px-3 py-1 rounded-full inline-flex items-center gap-1.5 whitespace-nowrap shadow-2xs';
                    summaryBadge.innerHTML = '<i class="fa-solid fa-circle-check text-[11px] text-emerald-600"></i> 1 đại lý · Đã tự động chốt thầu';
                } else if (isLocked) {
                    summaryBadge.className = 'text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-300 px-3 py-1 rounded-full inline-flex items-center gap-1.5 whitespace-nowrap shadow-2xs';
                    summaryBadge.innerHTML = `<i class="fa-solid fa-circle-check text-[11px] text-emerald-600"></i> ${list.length} đại lý · Đã chốt chính thức`;
                } else {
                    summaryBadge.className = 'text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-300 px-3 py-1 rounded-full inline-flex items-center gap-1.5 whitespace-nowrap shadow-2xs';
                    summaryBadge.innerHTML = `<i class="fa-regular fa-clock text-[11px] text-amber-600 animate-pulse"></i> ${list.length} đại lý · Trong thời gian điều chỉnh`;
                }
            }

            // Render Review Window Banner
            if (reviewBanner) {
                reviewBanner.classList.remove('hidden');
                if (reviewTimerInterval) { clearInterval(reviewTimerInterval); reviewTimerInterval = null; }

                if (isSingleAgent && list.length > 0) {
                    // Nếu chỉ có 1 đại lý đặt thì auto confirm và chốt thầu chính thức ngay vì chỉ có 1 đại lý
