                    } else {
                        actionContent = `<span class="text-slate-400 text-[11px] font-medium">Chờ tiếp nhận dự phòng #${item.rank}</span>`;
                    }
                }

                const isHighlight = item.isCurrentCandidate;

                return `
                    <tr class="${isHighlight ? 'bg-amber-50/40 font-medium' : 'hover:bg-slate-50'} transition">
                        <td class="py-3 px-3 text-center">${rankBadge}</td>
