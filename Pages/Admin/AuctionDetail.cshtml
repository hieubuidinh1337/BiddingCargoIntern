                                    <i class="fa-solid fa-lock text-amber-400"></i> Chốt thầu chính thức ngay
                                </button>
                            ` : `
                                <span class="text-slate-500 text-[11px] font-semibold bg-white/80 border border-purple-200 px-2.5 py-1 rounded-xl inline-flex items-center gap-1 shadow-2xs">
