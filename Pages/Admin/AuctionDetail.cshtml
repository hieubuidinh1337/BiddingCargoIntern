                    `;

                    // Start/Update live countdown timer
                    const deadlineMs = auction.reviewDeadline ? new Date(auction.reviewDeadline).getTime() : (Date.now() + (auction.reviewWindowMinutes || 15) * 60 * 1000);
                    function updateTimerDisplay() {
                        const remaining = deadlineMs - Date.now();
                        const timerElem = document.getElementById('reviewCountdownTimer');
                        if (remaining <= 0) {
                            if (timerElem) timerElem.textContent = '00:00';
                            clearInterval(reviewTimerInterval);
                            reviewTimerInterval = null;
                            CargoStore.lockAuctionReview(auction.id);
                            loadAdminDetail();
                            return;
                        }
                        const sec = Math.floor(remaining / 1000);
                        const m = Math.floor(sec / 60);
                        const s = sec % 60;
                        if (timerElem) timerElem.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                    }
                    updateTimerDisplay();
                    reviewTimerInterval = setInterval(updateTimerDisplay, 1000);
                }
            }

            if (historyBox) historyBox.classList.add('hidden');

            if (list.length === 0) {
                lbody.innerHTML = `
                    <tr>
