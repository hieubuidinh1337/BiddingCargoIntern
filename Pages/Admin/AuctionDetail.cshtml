                // Action Column: Cho phép Thay đổi đại lý trong thời gian điều chỉnh; khi hết giờ hoặc 1 đại lý thì chốt thầu chính thức
                let actionContent = '';
                if (isOpen) {
                    actionContent = '<span class="text-blue-600 text-[11px] font-medium bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-200 inline-flex items-center gap-1"><i class="fa-solid fa-signal text-[10px]"></i> Đang mở đấu giá</span>';
