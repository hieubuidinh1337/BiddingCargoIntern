                if (isOpen) {
                    statusBadge = '<span class="bg-blue-50 text-blue-700 font-semibold px-2.5 py-1 rounded-full text-[10px] inline-flex items-center gap-1 border border-blue-200"><i class="fa-solid fa-signal text-blue-500"></i> Đang mở đấu giá</span>';
                } else if ((item.isFinalLocked || isSingleAgent) && item.isCurrentCandidate) {
                    statusBadge = '<span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-full text-[10px] inline-flex items-center gap-1 border border-emerald-300 shadow-2xs"><i class="fa-solid fa-circle-check text-emerald-600"></i> THẮNG THẦU CHÍNH THỨC</span>';
                } else if (item.isRejected) {
                    statusBadge = '<span class="bg-rose-50 text-rose-700 font-semibold px-2.5 py-1 rounded-full text-[10px] inline-flex items-center gap-1 border border-rose-200"><i class="fa-solid fa-circle-xmark text-rose-500"></i> ĐÃ HỦY THẮNG THẦU</span>';
