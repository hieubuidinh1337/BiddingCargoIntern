                                            <th class="py-2.5 px-3 text-right">Mã Audit Hash</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100 text-[11px]">
                                        ${logs.map(log => `
                                            <tr class="hover:bg-white transition">
                                                <td class="py-2.5 px-3 font-mono text-slate-700 whitespace-nowrap">
                                                    <i class="fa-regular fa-clock text-slate-400 mr-1"></i>${log.formattedTime || log.timestamp}
                                                </td>
                                                <td class="py-2.5 px-3 whitespace-nowrap">
                                                    <strong class="text-slate-900 block">${log.actorName || log.actorUsername}</strong>
                                                    <span class="text-[10px] font-bold text-indigo-800 bg-indigo-50 border border-indigo-200 px-1.5 py-0.5 rounded inline-flex items-center gap-1 mt-0.5">
                                                        <i class="fa-solid fa-user-shield text-[9px] text-indigo-600"></i> ${log.actorRole || 'AUCTION SETTLEMENT'}
                                                    </span>
                                                </td>
                                                <td class="py-2.5 px-3 text-rose-700 font-medium">
                                                    <span class="font-mono font-bold text-rose-800">${log.fromAgentCode}</span>
                                                    <span class="block text-slate-600 text-[10px]">${log.fromAgentName} (${CargoStore.formatCurrency(log.fromPriceKg)}/Kg)</span>
                                                </td>
                                                <td class="py-2.5 px-3 text-emerald-700 font-medium">
                                                    <span class="font-mono font-bold text-emerald-800">${log.toAgentCode}</span>
                                                    <span class="block text-slate-600 text-[10px]">${log.toAgentName} (${CargoStore.formatCurrency(log.toPriceKg)}/Kg)</span>
                                                </td>
                                                <td class="py-2.5 px-3 text-slate-700 max-w-xs">
                                                    <strong class="text-slate-900 block font-semibold">${log.reason}</strong>
                                                    ${log.note ? `<span class="block text-slate-500 text-[10px] italic mt-0.5 bg-white p-1 rounded border border-slate-200/60">${log.note}</span>` : ''}
                                                </td>
                                                <td class="py-2.5 px-3 text-right font-mono text-[10px] text-slate-500 font-semibold whitespace-nowrap">
                                                    <span class="bg-slate-100 border border-slate-300 px-2 py-0.5 rounded text-[10px]">
                                                        <i class="fa-solid fa-fingerprint text-slate-400 mr-0.5"></i> ${log.auditHash || 'SEC-COD-VERIFIED'}
                                                    </span>
                                                </td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    `;
                } else {
                    auditTrailBox.classList.add('hidden');
                }
            }
        }

        // Chốt thầu chính thức ngay (kết thúc sớm thời gian điều chỉnh)
        window.handleLockAuctionReview = async function (auctionId) {
            const admin = CargoStore.getCurrentAdmin ? CargoStore.getCurrentAdmin() : {};
            const canSettle = (CargoStore.hasPermission && CargoStore.hasPermission('auctions.settle_select_winner', admin)) ||
                (CargoStore.hasSettlementRole && CargoStore.hasSettlementRole(admin));
            if (!canSettle) {
                if (window.Swal) Swal.fire('Từ chối quyền', 'Tài khoản của bạn không có quyền Chốt / Chọn đại lý thắng thầu (auctions.settle_select_winner)!', 'warning');
                else alert('Tài khoản của bạn không có quyền Chốt / Chọn đại lý thắng thầu (auctions.settle_select_winner)!');
                return;
            }
            const ok = window.Swal ? (await Swal.fire({
                title: 'Chốt thầu chính thức ngay?',
                text: 'Hành động này sẽ kết thúc sớm thời gian điều chỉnh và khóa chính thức kết quả trúng thầu cho đại lý hiện tại.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fa-solid fa-lock"></i> Chốt thầu chính thức ngay',
                confirmButtonColor: '#0f172a',
                cancelButtonText: 'Hủy'
            })).isConfirmed : confirm('Chốt thầu chính thức ngay và kết thúc thời gian điều chỉnh?');

            if (ok) {
                const res = CargoStore.lockAuctionReview(auctionId);
                if (res.success) {
                    if (window.Swal) Swal.fire({ icon: 'success', title: 'Đã khóa chốt thầu!', text: res.message });
                    loadAdminDetail();
                }
            }
        };

        // Action: Reject đại lý hiện tại và tự động chuyển sang đại lý kế tiếp
        // Phân quyền chuyên trách riêng: AUCTION SETTLEMENT (hoặc ITD ADMIN)
        // Ghi nhật ký Audit Trail đầy đủ, bảo mật
        async function handleRejectToNextAgent(auctionId, targetAgentCode, targetAgentName, priceKg) {
            const admin = CargoStore.getCurrentAdmin ? CargoStore.getCurrentAdmin() : {};
            const canSettle = (CargoStore.hasPermission && CargoStore.hasPermission('auctions.settle_select_winner', admin)) ||
                (CargoStore.hasSettlementRole && CargoStore.hasSettlementRole(admin));

            if (!canSettle) {
                if (window.Swal) {
                    const currentRolesStr = (Array.isArray(admin.roles) ? admin.roles.join(', ') : admin.role) || 'STAFF';
                    Swal.fire({
                        icon: 'error',
                        title: 'Từ chối quyền truy cập',
                        html: `
                            <div class="text-left text-xs space-y-2">
                                <p class="text-slate-700">Tài khoản hiện tại của bạn: <strong class="text-slate-900">${admin.fullName || admin.username}</strong> (@@${admin.username || 'staff'}).</p>
                                <p class="text-slate-600">Vai trò hiện có: <strong class="text-rose-600 font-bold">${currentRolesStr}</strong>.</p>
                                <div class="p-3 bg-purple-50 border border-purple-200 rounded-xl text-purple-950 leading-relaxed space-y-1">
                                    <div class="font-bold flex items-center gap-1.5 text-purple-900">
                                        <i class="fa-solid fa-gavel text-purple-600"></i> Thẩm quyền chuyên trách:
                                    </div>
                                    <p>Toàn bộ thao tác <strong>Confirm, Reject & điều chuyển thầu dự phòng</strong> đã được phân quyền cho <strong>auctions.settle_select_winner</strong> (hoặc AUCTION SETTLEMENT / SUPER ADMIN).</p>
                                </div>
                                <p class="text-[11px] text-slate-500">Vui lòng liên hệ Quản trị viên để cấp quyền nếu cần thiết.</p>
                            </div>
                        `
                    });
                } else {
                    alert('Quyền bị từ chối: Cần quyền auctions.settle_select_winner!');
                }
                return;
            }

            // Tìm đại lý dự phòng kế tiếp
            const list = CargoStore.getAuctionLeaderboard ? CargoStore.getAuctionLeaderboard(auctionId) : [];
            const rejectedCodes = ((currentAuction && currentAuction.rejectedAgents) || []).concat([targetAgentCode]).map(c => String(c).toUpperCase());
            const nextCandidate = list.find(item => !rejectedCodes.includes(item.agentCode.toUpperCase()) && item.agentCode.toUpperCase() !== targetAgentCode.toUpperCase());

            const nextAgentHtml = nextCandidate ? `
                <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-950 space-y-1">
