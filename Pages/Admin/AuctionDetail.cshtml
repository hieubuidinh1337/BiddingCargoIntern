                    rankBadge = '<span class="w-8 h-8 rounded-xl bg-amber-100 text-amber-800 font-black inline-flex items-center justify-center text-xs shadow-xs border border-amber-300">🥇 #1</span>';
                } else if (item.rank === 2) {
                    rankBadge = '<span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-700 font-bold inline-flex items-center justify-center text-xs border border-slate-300">🥈 #2</span>';
                } else if (item.rank === 3) {
                    rankBadge = '<span class="w-8 h-8 rounded-xl bg-orange-100 text-orange-800 font-bold inline-flex items-center justify-center text-xs border border-orange-300">🥉 #3</span>';
                } else {
                    rankBadge = `<span class="w-8 h-8 rounded-xl bg-slate-50 text-slate-500 font-semibold inline-flex items-center justify-center text-xs border">#${item.rank}</span>`;
