@page
@model BiddingCargo.Web.Pages.Admin.AuctionDetailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giám sát chi tiết phiên - Cargo Bidding Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="../assets/js/sweetalert2.all.min.js"></script>
    <script src="../assets/js/cargo-store.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Exo:ital,wght@@0,100;0,200;0,300;0,400;0,500;0,531;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,531;1,600;1,700;1,800;1,900"
        rel="stylesheet" />
    <style>
        body,
        input,
        select,
        textarea,
        button {
            font-family: 'Exo', sans-serif;
        }
    </style>
</head>

<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col"> <!-- ═══════════════════════════════════════════
         ADMIN HEADER — VU Cargo Admin Portal
         Premium dark navigation — DO NOT EDIT MANUALLY
         ═══════════════════════════════════════════ -->
    <style>
        /* ── Admin Header ── */
        #adminHeader {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f172a 100%);
            border-bottom: 1px solid rgba(59, 130, 246, 0.18);
            position: sticky;
            top: 0;
            z-index: 50;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
        }

        #adminHeader::after {
            content: '';
            display: block;
            height: 2px;
            background: linear-gradient(90deg, transparent 0%, #3b82f6 30%, #6366f1 65%, transparent 100%);
        }

        .admin-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 58px;
            gap: 0.75rem;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            flex-shrink: 0;
        }

        .admin-brand img {
            height: 32px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        .admin-brand-sep {
            width: 1px;
            height: 28px;
            background: rgba(255, 255, 255, 0.15);
        }

        .admin-brand-text {
            font-size: 0.8125rem;
            font-weight: 700;
            color: #e2e8f0;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

        .admin-brand-sub {
            font-size: 0.6rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: block;
        }

        /* Desktop Nav */
        .admin-nav {
            display: none;
            align-items: center;
            gap: 2px;
        }

        @@media (min-width:768px) {
            .admin-nav {
                display: flex;
            }
        }

        .nav-item-admin {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 0.72rem;
            font-weight: 600;
            color: rgba(203, 213, 225, 0.85);
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.15s ease;
            border: 1px solid transparent;
        }

        .nav-item-admin:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .nav-item-admin.active {
            color: #fff;
            background: rgba(59, 130, 246, 0.85);
            border-color: rgba(59, 130, 246, 0.5);
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.35);
        }

        .nav-item-admin.chat-item {
            color: #c4b5fd;
            background: rgba(139, 92, 246, 0.12);
            border-color: rgba(139, 92, 246, 0.25);
        }

        .nav-item-admin.chat-item:hover {
            color: #e9d5ff;
            background: rgba(139, 92, 246, 0.22);
        }

        .nav-item-admin.active-chat {
            color: #fff;
            background: rgba(139, 92, 246, 0.75);
            border-color: rgba(139, 92, 246, 0.5);
            box-shadow: 0 0 12px rgba(139, 92, 246, 0.35);
        }

        .chat-badge {
            background: #ef4444;
            color: #fff;
            font-size: 0.6rem;
            font-weight: 700;
            padding: 0 5px;
            border-radius: 999px;
            min-width: 16px;
            text-align: center;
            line-height: 16px;
            height: 16px;
        }

        /* Right Bar */
        .admin-right {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .admin-public-link {
            display: none;
            align-items: center;
            gap: 5px;
            font-size: 0.68rem;
            font-weight: 600;
            color: rgba(148, 163, 184, 0.9);
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 4px 10px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s;
        }

        @@media (min-width:1024px) {
            .admin-public-link {
                display: flex;
            }
        }

        .admin-public-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.1);
        }

        .admin-sep {
            width: 1px;
            height: 24px;
            background: rgba(255, 255, 255, 0.12);
        }

        .admin-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            color: #fff;
            font-weight: 800;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
        }

        .admin-user-info {
            display: none;
            flex-direction: column;
            text-align: left;
        }

        @@media (min-width:640px) {
            .admin-user-info {
                display: flex;
            }
        }

        .admin-user-name {
            font-size: 0.72rem;
            font-weight: 700;
            color: #e2e8f0;
            line-height: 1.2;
        }

        .admin-user-role {
            font-size: 0.6rem;
            font-weight: 700;
            color: #60a5fa;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .admin-logout {
            color: rgba(148, 163, 184, 0.7);
            padding: 6px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s;
            font-size: 0.8rem;
            border: 1px solid transparent;
        }

        .admin-logout:hover {
            color: #f87171;
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.2);
        }

        /* Mobile hamburger */
        .admin-hamburger {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #cbd5e1;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.15s;
        }

        .admin-hamburger:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
        }

        @@media (min-width:768px) {
            .admin-hamburger {
                display: none;
            }
        }

        /* Mobile dropdown */
        #adminMobileNav {
            display: none;
            padding: 0.75rem 1rem;
            background: #1e293b;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            max-width: 1400px;
            margin: 0 auto;
        }

        #adminMobileNav.open {
            display: block;
        }

        .mobile-nav-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 8px 12px;
            border-radius: 8px;
            margin-bottom: 2px;
            font-size: 0.76rem;
            font-weight: 600;
            color: #cbd5e1;
            text-decoration: none;
            transition: all 0.15s;
        }

        .mobile-nav-item:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
        }

        .mobile-nav-item.active {
            color: #fff;
            background: rgba(59, 130, 246, 0.75);
        }

        .mobile-nav-item.chat-item {
            color: #c4b5fd;
        }

        .mobile-nav-item.active-chat {
            color: #fff;
            background: rgba(139, 92, 246, 0.75);
        }
    </style>
    <header id="adminHeader">
        <div class="admin-inner">
            <!-- Brand -->
            <button type="button" class="admin-hamburger"
                onclick="document.getElementById('adminMobileNav').classList.toggle('open')" aria-label="Menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a href="02-AdminDashboard.html" class="admin-brand">
                <img src="../assets/images/vietravel-logo-doc.png" alt="Vietravel Airlines" />
                <div class="admin-brand-sep"></div>
                <div>
                    <span class="admin-brand-sub">Portal Quản Trị</span>
                    <span class="admin-brand-text">Cargo Admin</span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="admin-nav">
                <a href="02-AdminDashboard.html" class="nav-item-admin"><i
                        class="fa-solid fa-gauge-high"></i>Dashboard</a>
                <a href="03-AuctionList.html" class="nav-item-admin active"><i class="fa-solid fa-list-check"></i>Quản
                    lý phiên</a>
                <a href="04-CreateAuction.html" class="nav-item-admin"><i class="fa-solid fa-circle-plus"></i>Tạo
                    phiên</a>
                <a href="06-AgentList.html" class="nav-item-admin"><i class="fa-solid fa-building-user"></i>Đại lý</a>
                <a href="07-Reports.html" class="nav-item-admin"><i class="fa-solid fa-chart-line"></i>Báo cáo</a>
                <a href="08-Settings.html" class="nav-item-admin"><i class="fa-solid fa-gear"></i>Cài đặt</a>
                <a href="10-AuditLogs.html" class="nav-item-admin"><i class="fa-solid fa-clock-rotate-left"></i>Nhật
                    ký</a>
            </nav>

            <!-- Right Bar -->
            <div class="admin-right">
                <a href="../00-Home.html" target="_blank" class="admin-public-link">
                    <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i> Sàn công khai
                </a>
                <div class="admin-sep"></div>
                <div class="admin-avatar admin-header-avatar">AD</div>
                <div class="admin-user-info">
                    <span class="admin-user-name admin-header-name">Quản trị viên</span>
                    <span class="admin-user-role admin-header-role">QUẢN TRỊ VIÊN</span>
                </div>

                <a href="01-AdminLogin.html" onclick="if(window.CargoStore) CargoStore.logoutAdmin()"
                    class="admin-logout" title="Đăng xuất">
                    <i class="fa-solid fa-power-off"></i>
                </a>
            </div>
        </div>

        <!-- Mobile Dropdown -->
        <div id="adminMobileNav">
            <a href="02-AdminDashboard.html" class="mobile-nav-item"><i
                    class="fa-solid fa-gauge-high w-4"></i>Dashboard</a>
            <a href="03-AuctionList.html" class="mobile-nav-item active"><i class="fa-solid fa-list-check w-4"></i>Quản
                lý phiên</a>
            <a href="04-CreateAuction.html" class="mobile-nav-item"><i class="fa-solid fa-circle-plus w-4"></i>Tạo
                phiên</a>
            <a href="06-AgentList.html" class="mobile-nav-item"><i class="fa-solid fa-building-user w-4"></i>Đại lý</a>
            <a href="07-Reports.html" class="mobile-nav-item"><i class="fa-solid fa-chart-line w-4"></i>Báo cáo</a>
            <a href="08-Settings.html" class="mobile-nav-item"><i class="fa-solid fa-gear w-4"></i>Cài đặt</a>
            <a href="10-AuditLogs.html" class="mobile-nav-item"><i class="fa-solid fa-clock-rotate-left w-4"></i>Nhật
                ký</a>
            <a href="../00-Home.html" target="_blank" class="mobile-nav-item"
                style="border-top:1px solid rgba(255,255,255,0.08);margin-top:6px;padding-top:10px">
                <i class="fa-solid fa-arrow-up-right-from-square w-4"></i> Xem Sàn công khai
            </a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 space-y-4 sm:space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <a href="03-AuctionList.html"
                    class="text-xs text-slate-500 hover:text-blue-600 flex items-center gap-1 mb-1">
                    <i class="fa-solid fa-arrow-left"></i> Trở lại danh sách phiên
                </a>
                <h1 class="text-2xl font-bold text-slate-900 flex items-center flex-wrap gap-2">
                    <i class="fa-solid fa-tower-broadcast text-blue-600"></i>
                    Giám sát phiên đấu giá: <span id="adminFlightTitle" class="text-blue-600">VU130</span>
                    <span id="detStatusBadge" class="text-xs px-3 py-1 rounded-full font-bold border">Đang tải...</span>
                    <!-- <span id="detCountdownBadge"
                        class="hidden text-xs px-3 py-1 rounded-full font-mono font-bold bg-amber-50 text-amber-700 border border-amber-300 inline-flex items-center gap-1.5 shadow-2xs">
                        <i class="fa-solid fa-stopwatch text-amber-600 animate-pulse"></i> Còn lại: <span
                            id="detCountdownText">--:--:--</span>
                    </span> -->
                </h1>
                <p class="text-xs text-slate-500 mt-0.5" id="adminSubTitle">Mã phiên: FL-VU130-260815 · Tuyến: SGN - HAN
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2" id="adminActionButtons">
                <!-- Action buttons rendered by JS -->
            </div>
        </div>

        <!-- 4 KPI Specs for Auction -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white rounded-2xl p-4 border shadow-sm">
                <p class="text-xs text-slate-500 flex items-center justify-between">
                    <span>Mức giá cao nhất</span>
                    <i class="fa-solid fa-chart-line text-blue-500"></i>
                </p>
                <p class="text-xl font-bold text-blue-600 mt-1" id="detCurrentPrice">---</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border shadow-sm">
                <p class="text-xs text-slate-500 flex items-center justify-between">
                    <span>Tải trọng chào thầu</span>
                    <i class="fa-solid fa-weight-hanging text-slate-400"></i>
                </p>
                <p class="text-xl font-bold text-slate-900 mt-1" id="detCapacity">3,500 Kg</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border shadow-sm">
                <p class="text-xs text-slate-500 flex items-center justify-between">
                    <span>Giá khởi điểm sàn</span>
                    <i class="fa-solid fa-tag text-slate-400"></i>
                </p>
                <p class="text-xl font-bold text-slate-700 mt-1" id="detStartingPrice">18.000 đ</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border shadow-sm" id="detCountdownCard">
                <p class="text-xs text-slate-500 flex items-center justify-between">
                    <span>Thời gian đếm ngược</span>
                    <i class="fa-solid fa-hourglass-half text-amber-500"></i>
                </p>
                <div class="mt-1 flex items-baseline gap-1.5">
                    <p class="text-xl font-bold font-mono text-amber-600 tracking-tight" id="detCountdownCardTime">
                        --:--:--</p>
                </div>
            </div>
        </div>

        <!-- Flight Specs Detail Table -->
        <div class="bg-white rounded-2xl border shadow-sm p-5 text-xs space-y-3">
            <h3 class="font-bold text-sm text-slate-800 border-b pb-2 flex items-center gap-1.5">
                <i class="fa-solid fa-circle-info text-blue-600"></i> Thông tin hành trình & Khai thác
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-slate-600">
                <div><span class="text-gray-400 block">Tàu bay:</span> <strong class="text-slate-800"
                        id="detAircraft">Airbus A321neo Cargo</strong></div>
                <div><span class="text-gray-400 block">Giai đoạn bay:</span> <strong class="text-blue-700 font-bold"
                        id="detFlightPeriod">-</strong></div>
                <div><span class="text-gray-400 block">Khởi hành (ETD):</span> <strong class="text-slate-800"
                        id="detEtd">14:30 · 15/08/2026</strong></div>
                <div><span class="text-gray-400 block">Hạ cánh (ETA):</span> <strong class="text-slate-800"
                        id="detEta">16:45 · 15/08/2026</strong></div>
            </div>
            <div class="pt-2 border-t flex flex-wrap items-center gap-2">
                <span class="text-gray-400">Đại lý được quyền tham gia:</span>
                <span id="detAllowedAgentsBadge" class="font-semibold text-slate-700">Tất cả đại lý</span>
            </div>
        </div>

        <!-- Declared Cargo Box for Winner (Rendered if closed/winner exists) -->
        <div id="adminDeclaredCargoSection" class="hidden"></div>

        <!-- Bảng Xếp Hạng & Thứ Tự Trúng Thầu (Top Bidders & Tiếp Nhận Dự Phòng) -->
        <!-- Bảng Xếp Hạng & Thứ Tự Trúng Thầu (Top Bidders & Tiếp Nhận Dự Phòng) -->
        <div id="leaderboardSection" class="bg-white rounded-2xl border shadow-sm overflow-hidden space-y-3 p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b pb-3">
                <div>
                    <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-trophy text-amber-500 text-base"></i>
                        Bảng Tổng Kết Xếp Hạng Đặt Giá & Thứ Tự Trúng Thầu
                    </h3>
                    <p class="text-xs text-slate-500 mt-0.5">
                        Lưu ý: Hệ thống sẽ tự động xác nhận đại lý đưa ra mức giá cao nhất. Trong thời gian điều chỉnh,
                        hệ thống cho phép thay đổi đại lý thắng thầu nếu đại lý đã được xác nhận không hoàn tất nghĩa vụ
                        sau khi trúng thầu.
                    </p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <span
                        class="text-xs font-semibold text-slate-600 bg-slate-100 border border-slate-200 px-3 py-1 rounded-full inline-flex items-center gap-1.5 whitespace-nowrap shadow-2xs"
                        id="leaderboardSummaryBadge">
                        <i class="fa-solid fa-users text-[11px] text-slate-400"></i> 0 đại lý tham gia
                    </span>
                </div>
            </div>

            <!-- Review Countdown & Status Banner -->
            <div id="reviewWindowBanner" class="hidden"></div>

            <!-- Fallback handover history alert (if any transfer happened) -->
            <div id="fallbackHistoryAlert"
                class="hidden p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 space-y-1">
            </div>

            <!-- Notice when live sealed-bid or closed with 0 bids -->
            <div id="leaderboardNoticeWrapper" class="hidden"></div>

            <div id="leaderboardTableWrapper" class="overflow-x-auto">
                <table class="w-full text-xs text-left">
                    <thead class="bg-slate-50 text-slate-600 font-semibold border-b">
                        <tr>
                            <th class="py-3 px-3 text-center w-14">Thứ hạng</th>
                            <th class="py-3 px-4 min-w-[200px]">Đại lý tham gia</th>
                            <th class="py-3 px-3 min-w-[110px]">Mức giá (đ/Kg)</th>
                            <th class="py-3 px-3 min-w-[120px]">Tổng giá trị (VND)</th>
                            <th class="py-3 px-3 min-w-[110px]">Thời gian nộp</th>
                            <th class="py-3 px-3 min-w-[160px]">Trạng thái</th>
                            <th class="py-3 px-4 text-center min-w-[200px]">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100" id="leaderboardBody">
                        <tr>
                            <td colspan="7" class="py-6 text-center text-gray-400">Đang tải bảng xếp hạng...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Audit Trail Table of Rejections and Cascades -->
            <div id="rejectAuditTrailSection" class="hidden pt-3 border-t"></div>
        </div>

        <!-- Bids Realtime Log Table -->
        <div class="bg-white rounded-2xl border shadow-sm overflow-hidden space-y-3 p-5">
            <div class="flex items-center justify-between border-b pb-3">
                <div class="flex items-center gap-2">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-1.5">
                        <i class="fa-solid fa-list-ol text-blue-600"></i> Lịch sử các lượt đặt giá (Realtime Bidding
                        Log)
                    </h3>
                    <span id="staffBiddingNoticeBadge"
                        class="hidden text-[11px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-lg inline-flex items-center gap-1">
                        <i class="fa-solid fa-shield-halved text-amber-500"></i> Quyền Staff: Thông tin người đấu giá
                        được bảo mật ẩn danh
                    </span>
                </div>
                <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-lg" id="detBidsCount">0
                    lượt đặt</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left">
                    <thead class="bg-slate-50 text-slate-500 font-semibold border-b">
                        <tr>
                            <th class="py-3 px-4">Mã đại lý</th>
                            <th class="py-3 px-4">Tên đại lý</th>
                            <th class="py-3 px-4">Mức giá đặt (đ/Kg)</th>
                            <th class="py-3 px-4">Tổng giá trị (VND)</th>
                            <th class="py-3 px-4">Thời gian</th>
                            <th class="py-3 px-4">Trạng thái</th>
                        </tr>
