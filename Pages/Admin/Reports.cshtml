                            <div><span class="text-slate-400">MST:</span> <strong>${agent.taxId || '-'}</strong></div>
                            <div><span class="text-slate-400">Điện thoại:</span> <strong>${agent.phone || '-'}</strong></div>
                            <div class="col-span-2 truncate"><span class="text-slate-400">Email:</span> <strong>${agent.email || '-'}</strong></div>
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-2">
                        <div class="bg-emerald-50/70 border border-emerald-200/80 p-2.5 rounded-xl text-center">
                            <span class="text-[10px] font-bold text-emerald-800 uppercase block">Trúng thầu</span>
                            <span class="text-base font-extrabold text-emerald-600">${agentMetric.wonCount || 0}</span>
                            <span class="text-[10px] text-emerald-700 block">chuyến</span>
                        </div>
                        <div class="bg-blue-50/70 border border-blue-200/80 p-2.5 rounded-xl text-center">
                            <span class="text-[10px] font-bold text-blue-800 uppercase block">Lượt đặt thầu</span>
                            <span class="text-base font-extrabold text-blue-600">${agentMetric.totalBids || 0}</span>
                            <span class="text-[10px] text-blue-700 block">lượt</span>
                        </div>
                        <div class="bg-purple-50/70 border border-purple-200/80 p-2.5 rounded-xl text-center">
                            <span class="text-[10px] font-bold text-purple-800 uppercase block">Tổng chi tiêu</span>
                            <span class="text-xs font-extrabold text-purple-700 block truncate" title="${CargoStore.formatCurrency(agentMetric.totalSpentVND)}">${CargoStore.formatCurrency(agentMetric.totalSpentVND)}</span>
                            <span class="text-[9px] text-purple-600 block">~${CargoStore.formatNumber(spentUSD)} USD</span>
                        </div>
                    </div>

                    <div class="pt-2 flex justify-between items-center border-t border-slate-100">
                        <span class="text-slate-400 text-[11px]">Xem toàn bộ hồ sơ & lịch sử:</span>
                        <a href="09-AgentDetail.html?code=${agent.code}" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-xs flex items-center gap-1.5 transition">
                            <span>Chi tiết hồ sơ</span> <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            `;

            showReportModal({
                title: 'Hồ sơ đại lý trúng thầu',
                subtitle: `Mã đại lý: ${agent.code}`,
                message: contentHtml,
                type: 'info',
                confirmText: 'Đóng'
            });
        }

        function parseVietnameseDate(str) {
            if (!str || typeof str !== 'string') return 0;
            const vnMatch = str.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
            if (vnMatch) {
                const day = vnMatch[1].padStart(2, '0');
                const month = vnMatch[2].padStart(2, '0');
                const year = vnMatch[3];
                const timeMatch = str.match(/(\d{2}):(\d{2})/);
                const timeStr = timeMatch ? `${timeMatch[1]}:${timeMatch[2]}:00` : '12:00:00';
                return new Date(`${year}-${month}-${day}T${timeStr}`).getTime();
            }
            const isoMatch = str.match(/(\d{4})-(\d{2})-(\d{2})/);
            if (isoMatch) {
                const ts = new Date(str).getTime();
                if (!isNaN(ts)) return ts;
            }
            return 0;
        }

        function getItemTimestamp(item) {
            if (!item) return 0;
            if (item.rawTime) return item.rawTime;

            if (item.paymentDeadline) {
                const ts = new Date(item.paymentDeadline).getTime();
                if (!isNaN(ts) && ts > 0) return ts;
            }
            if (item.etdIso) {
                const ts = new Date(item.etdIso).getTime();
                if (!isNaN(ts) && ts > 0) return ts;
            }

            const vnDateFields = [item.paidAt, item.createdDate, item.etd, item.wonDate, item.paymentProof?.submittedAt, item.paymentProof?.rejectedAt];
            for (const f of vnDateFields) {
                const ts = parseVietnameseDate(f);
                if (ts > 0) return ts;
            }

            if (item.wonId) {
                const m1 = String(item.wonId).match(/WON-(\d{4})(\d{2})(\d{2})/);
                if (m1) return new Date(`${m1[1]}-${m1[2]}-${m1[3]}T12:00:00`).getTime();
                const m2 = String(item.wonId).match(/WON-(\d{4})-(\d{2})(\d{2})/);
                if (m2) return new Date(`${m2[1]}-${m2[2]}-${m2[3]}T12:00:00`).getTime();
            }

            if (item.flightCode) {
                const m = String(item.flightCode).match(/-(\d{2})(\d{2})(\d{2})$/);
                if (m) return new Date(`20${m[1]}-${m[2]}-${m[3]}T12:00:00`).getTime();
            }

            if (item.wonDate) {
                const ts = new Date(item.wonDate).getTime();
                if (!isNaN(ts) && ts > 0) return ts;
            }

            return 0;
        }

        // Compute dynamic metrics from live store data
        function computeReportMetrics(customData) {
            const store = getStore();
            const data = customData || (store ? store.getData() : {});
            let auctions = data.auctions || [];
            let bids = data.bids || [];
            let wonList = data.wonAuctions || [];
            let agentsList = data.agentsList || [];

            const filters = getReportFilters();
            const now = new Date();
            const oneDay = 24 * 60 * 60 * 1000;
            const nowTime = now.getTime();

            // Filter auctions by selected filter parameters - chỉ báo cáo phiên đã đóng / đã chốt
            const filteredAuctions = auctions.filter(a => {
                if (a.status !== 'CLOSED') return false;

                const rName = a.route || `${a.origin || 'SGN'} - ${a.destination || 'HAN'}`;
                if (filters.route !== 'ALL' && rName !== filters.route) return false;

                const aTs = getItemTimestamp(a);
                if (filters.timeRange === '30DAYS') {
                    if (aTs > 0 && (nowTime - aTs > 30 * oneDay)) return false;
                } else if (filters.timeRange === '90DAYS') {
                    if (aTs > 0 && (nowTime - aTs > 90 * oneDay)) return false;
                } else if (filters.timeRange === 'THIS_MONTH') {
                    if (aTs > 0) {
                        const d = new Date(aTs);
                        if (d.getFullYear() !== now.getFullYear() || d.getMonth() !== now.getMonth()) return false;
                    }
                } else if (filters.timeRange === 'LAST_MONTH') {
                    if (aTs > 0) {
                        const lmDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                        const d = new Date(aTs);
                        if (d.getFullYear() !== lmDate.getFullYear() || d.getMonth() !== lmDate.getMonth()) return false;
                    }
                } else if (filters.timeRange === 'CUSTOM') {
                    const fromTs = filters.fromDate ? new Date(filters.fromDate + 'T00:00:00').getTime() : 0;
                    const toTs = filters.toDate ? new Date(filters.toDate + 'T23:59:59.999').getTime() : Infinity;
                    if (aTs > 0 && (aTs < fromTs || aTs > toTs)) return false;
                }

                return true;
            });

            // Filter wonList by selected filter parameters
            const filteredWonList = wonList.filter(w => {
                const rName = w.route || (w.flightNumber ? w.flightNumber : '');
                if (filters.route !== 'ALL' && !rName.includes(filters.route)) return false;

                const wTs = getItemTimestamp(w);
                if (filters.timeRange === '30DAYS') {
                    if (wTs > 0 && (nowTime - wTs > 30 * oneDay)) return false;
                } else if (filters.timeRange === '90DAYS') {
                    if (wTs > 0 && (nowTime - wTs > 90 * oneDay)) return false;
                } else if (filters.timeRange === 'THIS_MONTH') {
                    if (wTs > 0) {
                        const d = new Date(wTs);
                        if (d.getFullYear() !== now.getFullYear() || d.getMonth() !== now.getMonth()) return false;
                    }
                } else if (filters.timeRange === 'LAST_MONTH') {
                    if (wTs > 0) {
                        const lmDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                        const d = new Date(wTs);
                        if (d.getFullYear() !== lmDate.getFullYear() || d.getMonth() !== lmDate.getMonth()) return false;
                    }
                } else if (filters.timeRange === 'CUSTOM') {
                    const fromTs = filters.fromDate ? new Date(filters.fromDate + 'T00:00:00').getTime() : 0;
                    const toTs = filters.toDate ? new Date(filters.toDate + 'T23:59:59.999').getTime() : Infinity;
                    if (wTs > 0 && (wTs < fromTs || wTs > toTs)) return false;
                }

                return true;
            });

            const routeMap = {};
            let grandTotalRevenue = 0;
            let grandTotalOfferedKg = 0;
            let grandTotalWonKg = 0;
            let closedCount = 0;

            // 1. Group filtered auctions by route
            filteredAuctions.forEach(a => {
                const routeName = a.route || `${a.origin || 'SGN'} - ${a.destination || 'HAN'}`;
                if (!routeMap[routeName]) {
                    routeMap[routeName] = {
                        route: routeName,
                        flightCount: 0,
                        totalOfferedKg: 0,
                        totalWonKg: 0,
                        totalRevenue: 0
                    };
                }

                const rm = routeMap[routeName];
                rm.flightCount += 1;
                const capacity = Number(a.capacityKg) || 0;
                rm.totalOfferedKg += capacity;
                grandTotalOfferedKg += capacity;

                const hasBids = (a.bidsCount > 0) || (bids.some(b => b.auctionId == a.id)) || (a.status === 'CLOSED');
                const finalPrice = Number(a.winningPriceKg) || Number(a.currentPriceKg) || Number(a.startingPriceKg) || 0;

                if (hasBids) {
                    rm.totalWonKg += capacity;
                    grandTotalWonKg += capacity;
                    const rev = capacity * finalPrice;
                    rm.totalRevenue += rev;
                    grandTotalRevenue += rev;
                }

                if (a.status === 'CLOSED') {
                    closedCount++;
                }
            });

            // Factor in filteredWonList if any won auctions aren't in auctions array
            filteredWonList.forEach(w => {
                const routeName = w.route || (w.flightNumber ? w.flightNumber : 'Khác');
                if (!filteredAuctions.some(a => a.id == w.auctionId || (a.flightCode && a.flightCode === w.flightCode))) {
                    if (!routeMap[routeName]) {
                        routeMap[routeName] = {
                            route: routeName,
                            flightCount: 1,
                            totalOfferedKg: Number(w.capacityKg) || 0,
                            totalWonKg: Number(w.capacityKg) || 0,
                            totalRevenue: Number(w.totalAmountVND) || ((w.capacityKg || 0) * (w.priceKg || 0))
                        };
                        grandTotalOfferedKg += (w.capacityKg || 0);
                        grandTotalWonKg += (w.capacityKg || 0);
                        grandTotalRevenue += routeMap[routeName].totalRevenue;
                    }
                }
            });

            const grandFillRate = grandTotalOfferedKg > 0 ? (grandTotalWonKg / grandTotalOfferedKg * 100) : 0;
            const grandAvgPrice = grandTotalWonKg > 0 ? Math.round(grandTotalRevenue / grandTotalWonKg) : 0;

            // 2. Compute dynamic stats for Top Agents
            const agentStats = {};
            agentsList.forEach(ag => {
                agentStats[ag.code] = {
                    code: ag.code,
                    companyName: ag.companyName,
                    tier: ag.tier || 'TIER2',
                    totalBids: ag.totalBids || 0,
                    wonCount: ag.totalWins || 0,
                    totalSpentVND: ag.totalSpentVND || 0
                };
            });

            // Count placed bids from bids array
            bids.forEach(b => {
                const c = b.agentCode;
                if (c) {
                    if (!agentStats[c]) {
                        agentStats[c] = {
                            code: c,
                            companyName: b.agentName || c,
                            tier: 'TIER2',
                            totalBids: 0,
                            wonCount: 0,
                            totalSpentVND: 0
                        };
                    }
                    agentStats[c].totalBids += 1;
                }
            });

            // Calculate spent and won from filtered closed auctions
            filteredAuctions.forEach(a => {
                const winner = a.winnerAgentCode || (a.status === 'CLOSED' ? a.leadingAgentCode : null);
                if (winner && a.bidsCount > 0) {
                    if (!agentStats[winner]) {
                        agentStats[winner] = {
                            code: winner,
                            companyName: a.winnerAgentName || a.leadingAgentName || winner,
                            tier: 'TIER2',
                            totalBids: a.bidsCount,
                            wonCount: 0,
                            totalSpentVND: 0
                        };
                    }
                    agentStats[winner].wonCount += 1;
                    const price = Number(a.winningPriceKg) || Number(a.currentPriceKg) || 0;
                    agentStats[winner].totalSpentVND += ((a.capacityKg || 0) * price);
                }
            });

            filteredWonList.forEach(w => {
                const winner = w.agentCode;
                if (winner) {
                    if (!agentStats[winner]) {
                        agentStats[winner] = {
                            code: winner,
                            companyName: w.companyName || winner,
                            tier: 'TIER2',
                            totalBids: 1,
                            wonCount: 0,
                            totalSpentVND: 0
                        };
                    }
                    if (!filteredAuctions.some(a => (a.winnerAgentCode === winner || a.leadingAgentCode === winner) && a.id == w.auctionId)) {
                        agentStats[winner].wonCount += 1;
                        agentStats[winner].totalSpentVND += (w.totalAmountVND || ((w.capacityKg || 0) * (w.priceKg || 0)));
                    }
                }
            });

            // Xếp hạng Top đại lý theo số chuyến TRÚNG THẦU NHIỀU NHẤT (wonCount)
            const sortedAgents = Object.values(agentStats)
                .filter(a => a.totalBids > 0 || a.wonCount > 0 || a.totalSpentVND > 0)
                .sort((a, b) => {
                    if (b.wonCount !== a.wonCount) return b.wonCount - a.wonCount;
                    if (b.totalSpentVND !== a.totalSpentVND) return b.totalSpentVND - a.totalSpentVND;
                    return (b.totalBids || 0) - (a.totalBids || 0);
                });

            const finalTopAgents = sortedAgents.length > 0
                ? sortedAgents
                : [...agentsList].sort((a, b) => (b.totalWins || 0) - (a.totalWins || 0)).slice(0, 3).map(ag => ({
                    code: ag.code,
                    companyName: ag.companyName,
                    tier: ag.tier || 'TIER2',
                    totalBids: ag.totalBids || 0,
                    wonCount: ag.totalWins || 0,
                    totalSpentVND: ag.totalSpentVND || 0
                }));

            return {
                grandTotalRevenue,
                grandTotalOfferedKg,
                grandTotalWonKg,
                grandFillRate,
                grandAvgPrice,
                closedCount,
                routes: Object.values(routeMap),
                topAgents: finalTopAgents,
                filteredAuctions,
                filteredWonList,
                filters
            };
        }

        // Render dynamic UI from store
        function renderReportUI(e) {
            const passedData = (e && e.detail) ? e.detail : (window.CargoStore ? CargoStore.getData() : null);
            const metrics = computeReportMetrics(passedData);

            // 1. Render 3 KPI Cards
            const kpiRev = document.getElementById('kpiTotalRevenue');
            const kpiRevSub = document.getElementById('kpiRevenueSubtext');
            const kpiCap = document.getElementById('kpiTotalCapacity');
            const kpiFillSub = document.getElementById('kpiFillRateSubtext');
            const kpiPrice = document.getElementById('kpiAvgPrice');

            if (kpiRev) kpiRev.textContent = CargoStore.formatCurrency(metrics.grandTotalRevenue);
            if (kpiRevSub) kpiRevSub.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600"></i> Tổng từ ${metrics.closedCount} phiên đã đóng/chốt thầu`;
            if (kpiCap) kpiCap.textContent = CargoStore.formatNumber(metrics.grandTotalOfferedKg) + ' Kg';
            if (kpiPrice) kpiPrice.textContent = CargoStore.formatCurrency(metrics.grandAvgPrice) + '/Kg';

            const periodBadge = document.getElementById('reportPeriodBadge');
            if (periodBadge) {
                const flt = metrics.filters || {};
                const parts = [];
                if (flt.timeRange === 'THIS_MONTH') parts.push('Tháng 09/2026');
                else if (flt.timeRange === 'LAST_MONTH') parts.push('Tháng 08/2026');
                else if (flt.timeRange === '30DAYS') parts.push('30 ngày qua');
                else if (flt.timeRange === '90DAYS') parts.push('90 ngày qua');
                else if (flt.timeRange === 'CUSTOM' && (flt.fromDate || flt.toDate)) parts.push(`${flt.fromDate || '...'} đến ${flt.toDate || '...'}`);
                else parts.push('Tất cả thời gian');

                if (flt.route && flt.route !== 'ALL') parts.push(`Tuyến: ${flt.route}`);
                if (flt.status && flt.status !== 'ALL') parts.push(`Trạng thái: ${flt.status}`);

                periodBadge.textContent = `${parts.join(' · ')}`;
            }

            // 2. Render Route Revenue Table
            const tbody = document.getElementById('routeReportTableBody');
            if (tbody) {
                if (!metrics.routes || metrics.routes.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-gray-400">Chưa có dữ liệu chuyến bay nào trong hệ thống</td></tr>`;
                } else {
                    const dotColors = ['bg-blue-500', 'bg-emerald-500', 'bg-purple-500', 'bg-amber-500', 'bg-indigo-500'];
                    const barColors = ['bg-blue-500', 'bg-emerald-500', 'bg-purple-500', 'bg-amber-500', 'bg-indigo-500'];
                    const textColors = ['text-blue-600', 'text-emerald-600', 'text-purple-600', 'text-amber-600', 'text-indigo-600'];

                    const rowsHtml = metrics.routes.map((r, idx) => {
                        const fillRate = r.totalOfferedKg > 0 ? (r.totalWonKg / r.totalOfferedKg * 100) : 0;
                        const avgPrice = r.totalWonKg > 0 ? Math.round(r.totalRevenue / r.totalWonKg) : 0;
                        const dotColor = dotColors[idx % dotColors.length];
                        const barColor = barColors[idx % barColors.length];
                        const textColor = textColors[idx % textColors.length];

                        return `
                            <tr class="hover:bg-slate-50 transition">
                                <td class="py-3 px-3.5 font-bold text-slate-800 whitespace-nowrap">
                                    <span class="w-2 h-2 rounded-full ${dotColor} inline-block mr-1.5"></span> ${r.route}
                                </td>
                                <td class="py-3 px-3.5 font-medium text-slate-700 whitespace-nowrap">${r.flightCount} chuyến</td>
                                <td class="py-3 px-3.5 text-slate-600 whitespace-nowrap">${CargoStore.formatNumber(r.totalOfferedKg)} Kg</td>
                                <td class="py-3 px-3.5 font-bold text-slate-900 whitespace-nowrap">${CargoStore.formatNumber(r.totalWonKg)} Kg</td>
                                <td class="py-3 px-3.5 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <div class="w-16 sm:w-20 bg-gray-200 h-2 rounded-full overflow-hidden">
                                            <div class="${barColor} h-full" style="width: ${Math.min(fillRate, 100)}%;"></div>
                                        </div>
                                        <span class="font-bold ${textColor}">${fillRate.toFixed(1)}%</span>
                                    </div>
                                </td>
                                <td class="py-3 px-3.5 font-semibold text-blue-600 whitespace-nowrap">${CargoStore.formatCurrency(avgPrice)}/Kg</td>
                                <td class="py-3 px-3.5 text-right font-bold text-slate-900 whitespace-nowrap">${CargoStore.formatCurrency(r.totalRevenue)}</td>
                            </tr>
                        `;
                    }).join('');

                    const totalSummaryRow = `
                        <tr class="bg-slate-50 font-bold border-t-2 border-slate-300 text-slate-900">
                            <td class="py-3 px-3.5 uppercase text-blue-800 whitespace-nowrap">
                                <i class="fa-solid fa-plane-departure mr-1 text-blue-600"></i> Tổng cộng toàn mạng
                            </td>
                            <td class="py-3 px-3.5 text-slate-800 whitespace-nowrap">${metrics.routes.reduce((sum, r) => sum + r.flightCount, 0)} chuyến</td>
                            <td class="py-3 px-3.5 text-slate-700 whitespace-nowrap">${CargoStore.formatNumber(metrics.grandTotalOfferedKg)} Kg</td>
                            <td class="py-3 px-3.5 text-blue-700 whitespace-nowrap">${CargoStore.formatNumber(metrics.grandTotalWonKg)} Kg</td>
                            <td class="py-3 px-3.5 whitespace-nowrap">
                                <span class="text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded text-[11px] font-bold">
                                    ${metrics.grandFillRate.toFixed(1)}%
                                </span>
                            </td>
                            <td class="py-3 px-3.5 text-blue-700 whitespace-nowrap">${CargoStore.formatCurrency(metrics.grandAvgPrice)}/Kg</td>
                            <td class="py-3 px-3.5 text-right text-sm sm:text-base text-blue-700 font-extrabold whitespace-nowrap">${CargoStore.formatCurrency(metrics.grandTotalRevenue)}</td>
                        </tr>
                    `;

                    tbody.innerHTML = rowsHtml + totalSummaryRow;
                }
            }

            // 3. Render Top Agents (Ưu tiên số chuyến trúng thầu nhiều nhất)
            const topBox = document.getElementById('topAgentsContainer');
            if (topBox) {
                const agentsToShow = metrics.topAgents.slice(0, 3);
                if (agentsToShow.length === 0) {
                    topBox.innerHTML = `<div class="col-span-3 text-center py-6 text-gray-400">Chưa có dữ liệu trúng thầu của đại lý</div>`;
                } else {
                    const medalBadges = [
                        { bg: 'bg-gradient-to-r from-amber-500 to-amber-600', ring: 'ring-amber-200', cardBg: 'bg-gradient-to-b from-amber-50/50 to-white border-amber-200/90 shadow-xs', num: '1', label: 'Thứ nhất' },
                        { bg: 'bg-gradient-to-r from-slate-400 to-slate-500', ring: 'ring-slate-200', cardBg: 'bg-white border-slate-200 shadow-xs', num: '2', label: 'Thứ nhì' },
                        { bg: 'bg-gradient-to-r from-amber-700 to-amber-800', ring: 'ring-amber-200', cardBg: 'bg-white border-slate-200 shadow-xs', num: '3', label: 'Thứ ba' }
                    ];

                    topBox.innerHTML = agentsToShow.map((ag, idx) => {
                        const m = medalBadges[idx] || medalBadges[1];
                        const spentUSD = Math.round((ag.totalSpentVND || 0) / 25000);
                        return `
                            <div class="p-4 sm:p-5 rounded-2xl border ${m.cardBg} space-y-3 hover:shadow-md transition-all relative overflow-hidden group">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-full ${m.bg} text-white font-extrabold flex items-center justify-center text-[10px] sm:text-xs shadow-sm ring-2 ${m.ring}">${m.num}</span>
                                        <span class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider">${m.label}</span>
                                    </div>
                                    <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full flex items-center gap-1.5 shadow-2xs">
                                        <i class="fa-solid fa-trophy text-amber-500 text-[11px]"></i>
                                        <strong>${ag.wonCount || 0}</strong> chuyến thắng
                                    </span>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-900 text-sm leading-tight truncate group-hover:text-blue-600 transition" title="${ag.companyName}">${ag.companyName}</h3>
                                    <p class="text-slate-400 font-mono text-[11px] mt-0.5">${ag.code}</p>
                                </div>
                                <div class="pt-2.5 border-t border-slate-100 grid grid-cols-2 gap-2 text-xs">
                                    <div>
                                        <span class="text-slate-400 block text-[10px] font-medium">Lượt đặt giá</span>
                                        <strong class="text-slate-800 font-semibold">${ag.totalBids || 0} lượt</strong>
                                    </div>
                                    <div>
                                        <span class="text-slate-400 block text-[10px] font-medium">Tổng giá trị trúng</span>
                                        <strong class="text-blue-600 font-semibold">${CargoStore.formatCurrency(ag.totalSpentVND)}</strong>
                                        ${spentUSD > 0 ? `<span class="text-[9px] font-normal text-slate-400 block">(~${CargoStore.formatNumber(spentUSD)} USD)</span>` : ''}
                                    </div>
                                </div>
                                <div class="pt-2 flex items-center justify-between border-t border-dashed border-slate-100">
