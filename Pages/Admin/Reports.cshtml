    <script>
        function getReportFilters() {
            const timeRange = document.getElementById('reportTimeRangeFilter')?.value || 'ALL';
            const route = document.getElementById('reportRouteFilter')?.value || 'ALL';
            const fromDate = document.getElementById('reportFromDate')?.value || '';
            const toDate = document.getElementById('reportToDate')?.value || '';

            return { timeRange, route, fromDate, toDate };
        }

        function toggleCustomDateReport(val) {
            const customRow = document.getElementById('reportCustomDateRow');
            if (customRow) {
                if (val === 'CUSTOM') {
                    customRow.classList.remove('hidden');
                } else {
                    customRow.classList.add('hidden');
                }
            }
            applyReportFilters();
        }

        function resetReportFilters() {
            if (document.getElementById('reportTimeRangeFilter')) document.getElementById('reportTimeRangeFilter').value = 'ALL';
            if (document.getElementById('reportRouteFilter')) document.getElementById('reportRouteFilter').value = 'ALL';
            if (document.getElementById('reportFromDate')) document.getElementById('reportFromDate').value = '';
            if (document.getElementById('reportToDate')) document.getElementById('reportToDate').value = '';

            const customRow = document.getElementById('reportCustomDateRow');
            if (customRow) customRow.classList.add('hidden');
            renderReportUI();
            showToast('Đã đặt lại bộ lọc báo cáo!', true);
        }

        function applyReportFilters() {
            renderReportUI();
        }

        function toggleAdminMobileNav() {
            const nav = document.getElementById('adminMobileNav');
            if (nav) nav.classList.toggle('hidden');
        }

        function showToast(msg, isSuccess = true) {
            const toast = document.getElementById('toastReport');
            const icon = document.getElementById('toastIcon');
            const txt = document.getElementById('toastMsg');
            if (!toast || !txt) return;

            txt.textContent = msg;
            icon.className = isSuccess ? 'fa-solid fa-circle-check text-emerald-400 text-base' : 'fa-solid fa-circle-exclamation text-amber-400 text-base';
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');

            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3500);
        }

        // HTML Modal Dialog Controllers
        function showReportModal({ title = 'Thông báo', subtitle = 'Hệ thống Báo cáo & Thống kê', message = '', type = 'info', confirmText = 'Đã hiểu', onConfirm = null }) {
            const modal = document.getElementById('reportCustomModal');
            const box = document.getElementById('reportModalBox');
            const headerColor = document.getElementById('reportModalHeaderColor');
            const iconContainer = document.getElementById('reportModalIconContainer');
            const icon = document.getElementById('reportModalIcon');
            const titleEl = document.getElementById('reportModalTitle');
            const subEl = document.getElementById('reportModalSubtitle');
            const bodyEl = document.getElementById('reportModalBody');
            const actionsEl = document.getElementById('reportModalActions');

            if (!modal) return;

            // Types: success | warning | error | info
            let iconClass = 'fa-solid fa-circle-info';
            let colorClass = 'bg-blue-600';
            let containerBg = 'bg-blue-50 text-blue-600 border-blue-100';

            if (type === 'success') {
                iconClass = 'fa-solid fa-circle-check';
                colorClass = 'bg-emerald-600';
                containerBg = 'bg-emerald-50 text-emerald-600 border-emerald-100';
            } else if (type === 'warning') {
                iconClass = 'fa-solid fa-triangle-exclamation';
                colorClass = 'bg-amber-500';
                containerBg = 'bg-amber-50 text-amber-600 border-amber-100';
            } else if (type === 'error') {
                iconClass = 'fa-solid fa-circle-xmark';
                colorClass = 'bg-red-600';
                containerBg = 'bg-red-50 text-red-600 border-red-100';
            }

            if (headerColor) headerColor.className = `h-1.5 w-full ${colorClass}`;
            if (iconContainer) iconContainer.className = `w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 text-xl border shadow-xs ${containerBg}`;
            if (icon) icon.className = iconClass;
            if (titleEl) titleEl.textContent = title;
            if (subEl) subEl.textContent = subtitle;

            if (bodyEl) {
                if (typeof message === 'string') {
                    bodyEl.innerHTML = message;
                } else if (message instanceof HTMLElement) {
                    bodyEl.innerHTML = '';
                    bodyEl.appendChild(message);
                }
            }

            if (actionsEl) {
                actionsEl.innerHTML = '';
                const confirmBtn = document.createElement('button');
                confirmBtn.type = 'button';
                confirmBtn.className = 'px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl shadow-xs transition cursor-pointer';
                confirmBtn.textContent = confirmText;
                confirmBtn.onclick = () => {
                    closeReportModal();
                    if (typeof onConfirm === 'function') onConfirm();
                };
                actionsEl.appendChild(confirmBtn);
            }

            modal.classList.remove('hidden', 'pointer-events-none');
            requestAnimationFrame(() => {
                modal.classList.remove('opacity-0');
                if (box) box.classList.remove('scale-95');
            });
        }

        function closeReportModal() {
            const modal = document.getElementById('reportCustomModal');
            const box = document.getElementById('reportModalBox');
            if (!modal) return;

            modal.classList.add('opacity-0');
            if (box) box.classList.add('scale-95');

            setTimeout(() => {
                modal.classList.add('hidden', 'pointer-events-none');
            }, 200);
        }

        // Tự động chuyển đổi toàn bộ popup alert của trình duyệt thành HTML Modal đẹp mắt
        window.alert = function (msg) {
            showReportModal({
                title: 'Thông báo hệ thống',
                subtitle: 'Hệ thống Đấu giá Cargo',
                message: `<div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-medium text-slate-800 whitespace-pre-line text-xs">${msg}</div>`,
                type: 'info'
            });
        };

        // Modal chi tiết đại lý trúng thầu dạng HTML
