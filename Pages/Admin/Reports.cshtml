@page
@model BiddingCargo.Web.Pages.Admin.ReportsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Báo cáo & Thống kê - Cargo Bidding Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="../assets/js/cargo-store.js?v=20260904_05"></script>
    <!-- SheetJS for real Excel (.xlsx) export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- html2pdf.js for real PDF export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Exo:ital,wght@@0,100;0,200;0,300;0,400;0,500;0,531;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,531;1,600;1,700;1,800;1,900" rel="stylesheet" />
    <style>
        body, input, select, textarea, button {
            font-family: 'Exo', sans-serif;
        }
    </style>
</head>

<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col"> <!-- ═══════════════════════════════════════════
         ADMIN HEADER — VU Cargo Admin Portal
         Premium dark navigation — DO NOT EDIT MANUALLY
         ═══════════════════════════════════════════ -->
    <style>
        /* ── Admin Header ── */
        #adminHeader {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f172a 100%);
            border-bottom: 1px solid rgba(59, 130, 246, 0.18);
            position: sticky;
            top: 0;
            z-index: 50;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
        }

        #adminHeader::after {
            content: '';
            display: block;
            height: 2px;
            background: linear-gradient(90deg, transparent 0%, #3b82f6 30%, #6366f1 65%, transparent 100%);
        }

        .admin-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 58px;
            gap: 0.75rem;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            flex-shrink: 0;
        }

        .admin-brand img {
            height: 32px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        .admin-brand-sep {
            width: 1px;
            height: 28px;
            background: rgba(255, 255, 255, 0.15);
        }

        .admin-brand-text {
            font-size: 0.8125rem;
            font-weight: 700;
            color: #e2e8f0;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

        .admin-brand-sub {
            font-size: 0.6rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: block;
        }

        /* Desktop Nav */
        .admin-nav {
            display: none;
            align-items: center;
            gap: 2px;
        }

        @@media (min-width:768px) {
            .admin-nav {
                display: flex;
            }
        }

        .nav-item-admin {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 8px;
            font-size: 0.72rem;
            font-weight: 600;
            color: rgba(203, 213, 225, 0.85);
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.15s ease;
            border: 1px solid transparent;
        }

        .nav-item-admin:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .nav-item-admin.active {
            color: #fff;
            background: rgba(59, 130, 246, 0.85);
            border-color: rgba(59, 130, 246, 0.5);
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.35);
        }

        .nav-item-admin.chat-item {
            color: #c4b5fd;
            background: rgba(139, 92, 246, 0.12);
            border-color: rgba(139, 92, 246, 0.25);
        }

        .nav-item-admin.chat-item:hover {
            color: #e9d5ff;
            background: rgba(139, 92, 246, 0.22);
        }

        .nav-item-admin.active-chat {
            color: #fff;
            background: rgba(139, 92, 246, 0.75);
            border-color: rgba(139, 92, 246, 0.5);
            box-shadow: 0 0 12px rgba(139, 92, 246, 0.35);
        }

        .chat-badge {
            background: #ef4444;
            color: #fff;
            font-size: 0.6rem;
            font-weight: 700;
            padding: 0 5px;
            border-radius: 999px;
            min-width: 16px;
            text-align: center;
            line-height: 16px;
            height: 16px;
        }

        /* Right Bar */
        .admin-right {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .admin-public-link {
            display: none;
            align-items: center;
            gap: 5px;
            font-size: 0.68rem;
            font-weight: 600;
            color: rgba(148, 163, 184, 0.9);
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 4px 10px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s;
        }

        @@media (min-width:1024px) {
            .admin-public-link {
                display: flex;
            }
        }

        .admin-public-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.1);
        }

        .admin-sep {
            width: 1px;
            height: 24px;
            background: rgba(255, 255, 255, 0.12);
        }

        .admin-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            color: #fff;
            font-weight: 800;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
        }

        .admin-user-info {
            display: none;
            flex-direction: column;
            text-align: left;
        }

        @@media (min-width:640px) {
            .admin-user-info {
                display: flex;
            }
        }

        .admin-user-name {
            font-size: 0.72rem;
            font-weight: 700;
            color: #e2e8f0;
            line-height: 1.2;
        }

        .admin-user-role {
            font-size: 0.6rem;
            font-weight: 700;
            color: #60a5fa;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .admin-logout {
            color: rgba(148, 163, 184, 0.7);
            padding: 6px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s;
            font-size: 0.8rem;
            border: 1px solid transparent;
        }

        .admin-logout:hover {
            color: #f87171;
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.2);
        }

        /* Mobile hamburger */
        .admin-hamburger {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #cbd5e1;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.15s;
        }

        .admin-hamburger:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
        }

        @@media (min-width:768px) {
            .admin-hamburger {
                display: none;
            }
        }

        /* Mobile dropdown */
        #adminMobileNav {
            display: none;
            padding: 0.75rem 1rem;
            background: #1e293b;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            max-width: 1400px;
            margin: 0 auto;
        }

        #adminMobileNav.open {
            display: block;
        }

        .mobile-nav-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 8px 12px;
            border-radius: 8px;
            margin-bottom: 2px;
            font-size: 0.76rem;
            font-weight: 600;
            color: #cbd5e1;
            text-decoration: none;
            transition: all 0.15s;
        }

        .mobile-nav-item:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
        }

        .mobile-nav-item.active {
            color: #fff;
            background: rgba(59, 130, 246, 0.75);
        }

        .mobile-nav-item.chat-item {
            color: #c4b5fd;
        }

        .mobile-nav-item.active-chat {
            color: #fff;
            background: rgba(139, 92, 246, 0.75);
        }
    </style>
    <header id="adminHeader">
        <div class="admin-inner">
            <!-- Brand -->
            <button type="button" class="admin-hamburger"
                onclick="document.getElementById('adminMobileNav').classList.toggle('open')" aria-label="Menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a href="02-AdminDashboard.html" class="admin-brand">
                <img src="../assets/images/vietravel-logo-doc.png" alt="Vietravel Airlines" />
                <div class="admin-brand-sep"></div>
                <div>
                    <span class="admin-brand-sub">Portal Quản Trị</span>
                    <span class="admin-brand-text">Cargo Admin</span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="admin-nav">
                <a href="02-AdminDashboard.html" class="nav-item-admin"><i
                        class="fa-solid fa-gauge-high"></i>Dashboard</a>
                <a href="03-AuctionList.html" class="nav-item-admin"><i class="fa-solid fa-list-check"></i>Quản lý
                    phiên</a>
                <a href="04-CreateAuction.html" class="nav-item-admin"><i class="fa-solid fa-circle-plus"></i>Tạo
                    phiên</a>
                <a href="06-AgentList.html" class="nav-item-admin"><i class="fa-solid fa-building-user"></i>Đại lý</a>
                <a href="07-Reports.html" class="nav-item-admin active"><i class="fa-solid fa-chart-line"></i>Báo
                    cáo</a>
                <a href="08-Settings.html" class="nav-item-admin"><i class="fa-solid fa-gear"></i>Cài đặt</a>
                <a href="10-AuditLogs.html" class="nav-item-admin"><i class="fa-solid fa-clock-rotate-left"></i>Nhật
                    ký</a>
            </nav>

            <!-- Right Bar -->
            <div class="admin-right">
                <a href="../00-Home.html" target="_blank" class="admin-public-link">
                    <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i> Sàn công khai
                </a>
                <div class="admin-sep"></div>
                <div class="admin-avatar admin-header-avatar">AD</div>
                <div class="admin-user-info">
                    <span class="admin-user-name admin-header-name">Quản trị viên</span>
                    <span class="admin-user-role admin-header-role">QUẢN TRỊ VIÊN</span>
                </div>
                <a href="01-AdminLogin.html" onclick="if(window.CargoStore) CargoStore.logoutAdmin()"
                    class="admin-logout" title="Đăng xuất">
                    <i class="fa-solid fa-power-off"></i>
                </a>
            </div>
        </div>

        <!-- Mobile Dropdown -->
        <div id="adminMobileNav">
            <a href="02-AdminDashboard.html" class="mobile-nav-item"><i
                    class="fa-solid fa-gauge-high w-4"></i>Dashboard</a>
            <a href="03-AuctionList.html" class="mobile-nav-item"><i class="fa-solid fa-list-check w-4"></i>Quản lý
                phiên</a>
            <a href="04-CreateAuction.html" class="mobile-nav-item"><i class="fa-solid fa-circle-plus w-4"></i>Tạo
                phiên</a>
            <a href="06-AgentList.html" class="mobile-nav-item"><i class="fa-solid fa-building-user w-4"></i>Đại lý</a>
            <a href="07-Reports.html" class="mobile-nav-item active"><i class="fa-solid fa-chart-line w-4"></i>Báo
                cáo</a>
            <a href="08-Settings.html" class="mobile-nav-item"><i class="fa-solid fa-gear w-4"></i>Cài đặt</a>
            <a href="10-AuditLogs.html" class="mobile-nav-item"><i class="fa-solid fa-clock-rotate-left w-4"></i>Nhật
                ký</a>
            <a href="../00-Home.html" target="_blank" class="mobile-nav-item"
                style="border-top:1px solid rgba(255,255,255,0.08);margin-top:6px;padding-top:10px">
                <i class="fa-solid fa-arrow-up-right-from-square w-4"></i> Xem Sàn công khai
            </a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 space-y-4 sm:space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-chart-line text-blue-600"></i> Báo cáo & Thống kê Hiệu quả Vận tải
                </h1>
                <p class="text-xs text-slate-500 mt-1">Phân tích doanh thu đấu giá tải trọng theo từng
                    chặng bay</p>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="exportToExcel(this)" id="btnExportExcel"
                    class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-file-excel text-sm"></i> <span>Xuất Excel (.xlsx)</span>
                </button>
                <button onclick="exportToPDF(this)" id="btnExportPdf"
                    class="bg-white border hover:bg-slate-50 text-slate-700 text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow-sm flex items-center gap-1.5 cursor-pointer">
                    <i class="fa-solid fa-file-pdf text-red-500 text-sm"></i> <span>Xuất PDF</span>
                </button>
            </div>
        </div>

        <!-- BỘ LỌC BÁO CÁO & XUẤT DỮ LIỆU -->
        <div class="bg-white rounded-2xl border shadow-sm p-4 space-y-3">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <div
                        class="w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm shadow-inner">
                        <i class="fa-solid fa-filter"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900">Bộ Lọc Báo Cáo & Tùy Chọn Xuất File</h3>
                        <p class="text-[11px] text-slate-500">Lọc dữ liệu theo thời gian và tuyến bay trước
                            khi xem & xuất file Excel / PDF</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 self-end md:self-auto">
                    <button onclick="resetReportFilters()"
                        class="bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold px-3 py-2 rounded-xl transition flex items-center gap-1 cursor-pointer">
                        <i class="fa-solid fa-rotate-left"></i> Đặt lại
                    </button>
                </div>
            </div>

            <!-- Controls Grid (2 Filters) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <!-- 1. Thời gian -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1 text-[11px]">
                        <i class="fa-solid fa-calendar text-blue-500 mr-1"></i>Khoảng thời gian:
                    </label>
                    <select id="reportTimeRangeFilter" onchange="toggleCustomDateReport(this.value)"
                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium text-slate-800 outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                        <option value="ALL">Tất cả thời gian</option>
                        <option value="THIS_MONTH">Tháng này (Tháng 09/2026)</option>
                        <option value="LAST_MONTH">Tháng trước (Tháng 08/2026)</option>
                        <option value="30DAYS">30 ngày qua</option>
                        <option value="90DAYS">90 ngày qua</option>
                        <option value="CUSTOM">📅 Tùy chọn khoảng ngày...</option>
                    </select>
                </div>

                <!-- 2. Tuyến đường bay -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1 text-[11px]">
                        <i class="fa-solid fa-plane-departure text-purple-500 mr-1"></i>Tuyến đường bay:
                    </label>
                    <select id="reportRouteFilter" onchange="applyReportFilters()"
                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium text-slate-800 outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                        <option value="ALL">Tất cả đường bay</option>
                        <option value="SGN - HAN">SGN - HAN (Sài Gòn - Hà Nội)</option>
                        <option value="SGN - DAD">SGN - DAD (Sài Gòn - Đà Nẵng)</option>
                        <option value="HAN - PQC">HAN - PQC (Hà Nội - Phú Quốc)</option>
                        <option value="SGN - PQC">SGN - PQC (Sài Gòn - Phú Quốc)</option>
                    </select>
                </div>
            </div>

            <!-- Custom Date Range inputs -->
            <div id="reportCustomDateRow"
                class="hidden pt-2 border-t border-slate-100 flex flex-wrap items-center gap-3 text-xs bg-blue-50/50 p-2.5 rounded-xl border border-blue-100 mt-1">
                <span class="font-bold text-slate-700 flex items-center gap-1">
                    <i class="fa-solid fa-calendar-days text-blue-600"></i> Khoảng ngày tùy chọn:
                </span>
                <div class="flex items-center gap-1.5">
                    <label for="reportFromDate" class="text-slate-600 font-medium">Từ ngày:</label>
                    <input type="date" id="reportFromDate" onchange="applyReportFilters()"
                        class="px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-slate-800 font-medium outline-none shadow-xs">
                </div>
                <div class="flex items-center gap-1.5">
                    <label for="reportToDate" class="text-slate-600 font-medium">Đến ngày:</label>
                    <input type="date" id="reportToDate" onchange="applyReportFilters()"
                        class="px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-slate-800 font-medium outline-none shadow-xs">
                </div>
            </div>
        </div>

        <!-- 3 Big Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white rounded-2xl p-5 border shadow-sm hover:shadow-md transition">
                <p class="text-xs text-slate-500 font-medium">Tổng doanh thu cargo qua thầu</p>
                <p class="text-2xl font-bold text-slate-900 mt-1" id="kpiTotalRevenue">0 đ</p>
                <span class="text-[11px] text-emerald-600 font-semibold flex items-center gap-1 mt-1"
                    id="kpiRevenueSubtext">
                    <i class="fa-solid fa-arrow-trend-up"></i> Tự động tính theo dữ liệu phiên
                </span>
            </div>
            <div class="bg-white rounded-2xl p-5 border shadow-sm hover:shadow-md transition">
                <p class="text-xs text-slate-500 font-medium">Tổng tải trọng khai thác</p>
                <p class="text-2xl font-bold text-blue-600 mt-1" id="kpiTotalCapacity">0 Kg</p>
            </div>
            <div class="bg-white rounded-2xl p-5 border shadow-sm hover:shadow-md transition">
                <p class="text-xs text-slate-500 font-medium">Giá thắng thầu bình quân</p>
                <p class="text-2xl font-bold text-purple-600 mt-1" id="kpiAvgPrice">0 đ/Kg</p>
                <span class="text-[11px] text-emerald-600 font-semibold block mt-1" id="kpiPriceSubtext">Tính trên toàn
                    bộ tải trọng trúng thầu</span>
            </div>
        </div>

        <!-- Revenue by Route Report Table -->
        <div class="bg-white rounded-2xl border shadow-sm p-6 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                        <i class="fa-solid fa-route text-blue-600"></i> Doanh thu & Tải trọng theo từng đường bay
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Tự động tổng hợp và nhóm từ toàn bộ các chuyến bay trong hệ
                        thống</p>
                </div>
                <span class="text-xs bg-slate-100 text-slate-700 px-3 py-1 rounded-lg font-medium"
                    id="reportPeriodBadge">Kỳ báo cáo: Đang cập nhật</span>
            </div>

            <div
                class="sm:hidden flex items-center gap-1.5 text-[11px] text-slate-500 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200">
                <i class="fa-solid fa-arrows-left-right text-blue-500"></i>
                <span>Bảng rộng: Vuốt ngang để xem tổng doanh thu</span>
            </div>

            <div class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-xs min-w-[720px] whitespace-nowrap">
                    <thead class="bg-slate-50 text-slate-600 font-semibold border-b">
                        <tr>
                            <th class="py-3 px-3.5 whitespace-nowrap">Tuyến đường bay</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Số chuyến đấu giá</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Tổng tải trọng chào</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Tải trọng trúng thầu</th>
                            <th class="py-3 px-3.5 whitespace-nowrap">Giá bình quân</th>
                            <th class="py-3 px-3.5 text-right whitespace-nowrap">Tổng doanh thu (VND)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100" id="routeReportTableBody">
                        <tr>
                            <td colspan="7" class="py-8 text-center text-gray-400">Đang tải dữ liệu báo cáo...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Top Active Agents -->
        <div class="bg-white rounded-2xl border shadow-sm p-6 space-y-4">
