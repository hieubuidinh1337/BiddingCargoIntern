        function getStore() {
            return (typeof CargoStore !== 'undefined') ? CargoStore : (typeof window !== 'undefined' ? window.CargoStore : null);
        }

        async function initReports() {
            const store = getStore();
            if (store) {
                try {
                    const apiUrl = (window.location && window.location.protocol.startsWith('http'))
                        ? '/api/data'
                        : '/api/data';
                    const res = await fetch(apiUrl);
                    if (res.ok) {
                        const sData = await res.json();
                        if (sData && sData.auctions && sData.auctions.length > 0) {
                            const currentData = store.getData();
                            currentData.auctions = sData.auctions;
                            currentData.bids = sData.bids || currentData.bids || [];
                            currentData.wonAuctions = sData.wonAuctions || currentData.wonAuctions || [];
                            currentData.agentsList = sData.agentsList || currentData.agentsList || [];
                            store.saveData(currentData, true);
                        }
                    }
                } catch (err) {
                    console.warn('Sync /api/data error:', err);
                }
            }

            renderReportUI();

            if (store && store.syncAdminHeaderUI) {
                store.syncAdminHeaderUI();
            }
        }

        document.addEventListener('DOMContentLoaded', initReports);

        // NOTE: cargostore_updated listener removed to eliminate reports screen flicker
    </script>
</body>

</html>