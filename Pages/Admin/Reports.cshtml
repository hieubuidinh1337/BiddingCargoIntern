        // 1. Export to Excel (.xlsx) using dynamic metrics
        function exportToExcel(btn) {
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-sm text-emerald-500"></i> <span>Đang tạo Excel...</span>';

            setTimeout(() => {
                try {
                    if (typeof XLSX === 'undefined') {
                        showReportModal({
                            title: 'Thư viện chưa sẵn sàng',
                            message: 'Thư viện XLSX đang được tải từ máy chủ CDN, vui lòng thử lại sau vài giây!',
                            type: 'warning'
                        });
                        btn.disabled = false;
                        btn.innerHTML = originalContent;
                        return;
                    }

                    const metrics = computeReportMetrics();

                    // Sheet 1: Route Revenue Overview
                    const routeData = metrics.routes.map((r, idx) => ({
                        "STT": idx + 1,
                        "Đường bay": r.route,
                        "Số chuyến": r.flightCount,
                        "Tải chào (Kg)": r.totalOfferedKg,
                        "Tải trúng (Kg)": r.totalWonKg,
                        "Giá bình quân (VND/Kg)": r.totalWonKg > 0 ? Math.round(r.totalRevenue / r.totalWonKg) : 0,
                        "Tổng doanh thu (VND)": r.totalRevenue
                    }));

                    routeData.push({
                        "STT": "TỔNG CỘNG",
                        "Đường bay": "Toàn mạng bay",
                        "Số chuyến": metrics.routes.reduce((sum, r) => sum + r.flightCount, 0),
                        "Tải chào (Kg)": metrics.grandTotalOfferedKg,
                        "Tải trúng thầu (Kg)": metrics.grandTotalWonKg,
                        "Giá bình quân (VND/Kg)": metrics.grandAvgPrice,
                        "Tổng doanh thu (VND)": metrics.grandTotalRevenue
                    });

                    // Sheet 2: Top Agents ranked by most won auctions
                    const agentData = metrics.topAgents.map((ag, idx) => ({
                        "Xếp hạng": idx + 1,
                        "Mã đại lý": ag.code,
                        "Tên doanh nghiệp": ag.companyName,
                        "Số chuyến thắng thầu (Trúng thầu)": ag.wonCount || 0,
                        "Tổng lượt đấu giá": ag.totalBids || 0,
                        "Tổng chi tiêu (VND)": ag.totalSpentVND || 0,
                        "Tổng chi tiêu (~USD)": Math.round((ag.totalSpentVND || 0) / 25000)
                    }));

                    // Sheet 3: Dynamic flight auctions from CargoStore (Chỉ phiên đã đóng)
                    const store = getStore();
                    const storeData = store ? store.getData() : {};
                    const auctions = (storeData.auctions || []).filter(a => a.status === 'CLOSED');
                    const isReportAdmin = storeData.currentAdmin && storeData.currentAdmin.role === 'ADMIN';
                    const auctionRows = auctions.map((a, idx) => {
                        const isOpen = a.status === 'OPEN';
                        return {
                            "STT": idx + 1,
                            "Mã phiên": a.flightCode || `FL-${a.id}`,
                            "Số hiệu chuyến": a.flightNumber || '-',
                            "Tuyến đường bay": a.route || `${a.origin} - ${a.destination}`,
                            "Loại tàu bay": a.aircraft || 'A321neo',
                            "Tải trọng (Kg)": a.capacityKg || 0,
                            "Giá khởi điểm (đ/Kg)": a.startingPriceKg || 0,
                            "Giá hiện tại / trúng (đ/Kg)": (isOpen && !isReportAdmin) ? '??? (Bảo mật)' : (a.winningPriceKg || a.currentPriceKg || 0),
                            "Số lượt đặt giá": a.bidsCount || 0,
                            "Đại lý dẫn đầu / Thắng": (!isReportAdmin) ? 'AG-*** (Bảo mật)' : (a.winnerAgentCode || a.leadingAgentCode || 'Chưa có'),
                            "Trạng thái": a.status === 'OPEN' ? 'ĐANG MỞ' : (a.status === 'CLOSED' ? 'ĐÃ ĐÓNG' : a.status)
                        };
                    });

                    // Sheet 4: Cargo Manifest Declarations
                    const wonAuctionsList = storeData.wonAuctions || [];
                    const cargoRows = wonAuctionsList.map((item, idx) => {
                        const decl = item.cargoDeclaration || {};
                        return {
                            "STT": idx + 1,
                            "Mã đơn thắng thầu": item.wonId,
                            "Số hiệu chuyến": item.flightNumber,
                            "Tuyến bay": item.route,
                            "Mã đại lý": item.agentCode,
                            "Tải trọng trúng (Kg)": item.capacityKg,
                            "Giá chốt (đ/Kg)": item.priceKg,
                            "Tổng tiền (VND)": item.totalAmountVND,
                            "Master AWB": item.awbNumber || '-',
                            "Trạng thái khai báo": decl.cargoName ? "Đã khai báo" : "Chưa điền",
                            "Mã HAWB": decl.hawbNumber || '-',
                            "Loại hàng hóa": decl.cargoType || '-',
                            "Tên mặt hàng": decl.cargoName || '-',
                            "Khối lượng khai báo (Kg)": decl.grossWeightKg || 0,
                            "Số kiện / Thùng": decl.piecesCount || 0,
                            "Thể tích (CBM)": decl.volumeCbm || 0,
                            "Shipper (Người gửi)": decl.shipperName || '-',
                            "Consignee (Người nhận)": decl.consigneeName || '-',
                            "Địa chỉ kho nhận": decl.consigneeAddress || '-',
                            "Yêu cầu bảo quản đặc biệt": decl.specialNotes || '-',
                            "Thời gian cập nhật": decl.updatedAt || '-'
                        };
                    });

                    const wb = XLSX.utils.book_new();
                    const wsRoutes = XLSX.utils.json_to_sheet(routeData);
                    const wsAgents = XLSX.utils.json_to_sheet(agentData);
                    const wsAuctions = XLSX.utils.json_to_sheet(auctionRows);
                    const wsCargo = XLSX.utils.json_to_sheet(cargoRows);

                    wsRoutes['!cols'] = [{ wch: 10 }, { wch: 32 }, { wch: 18 }, { wch: 20 }, { wch: 20 }, { wch: 16 }, { wch: 24 }, { wch: 24 }];
                    wsAgents['!cols'] = [{ wch: 10 }, { wch: 14 }, { wch: 34 }, { wch: 20 }, { wch: 18 }, { wch: 20 }, { wch: 22 }, { wch: 20 }];
                    wsAuctions['!cols'] = [{ wch: 6 }, { wch: 20 }, { wch: 16 }, { wch: 18 }, { wch: 22 }, { wch: 14 }, { wch: 20 }, { wch: 24 }, { wch: 16 }, { wch: 24 }, { wch: 14 }];
                    wsCargo['!cols'] = [{ wch: 6 }, { wch: 16 }, { wch: 14 }, { wch: 14 }, { wch: 12 }, { wch: 16 }, { wch: 14 }, { wch: 18 }, { wch: 16 }, { wch: 16 }, { wch: 18 }, { wch: 20 }, { wch: 24 }, { wch: 18 }, { wch: 12 }, { wch: 12 }, { wch: 22 }, { wch: 22 }, { wch: 30 }, { wch: 25 }, { wch: 20 }];

                    XLSX.utils.book_append_sheet(wb, wsRoutes, "DoanhThu_TuyenBay");
                    XLSX.utils.book_append_sheet(wb, wsAgents, "Top_DaiLy_TrungThau");
                    XLSX.utils.book_append_sheet(wb, wsAuctions, "ChiTiet_ChuyenBay");
                    XLSX.utils.book_append_sheet(wb, wsCargo, "KhaiBao_HangHoa");

                    const now = new Date();
                    const fileName = `BaoCao_HieuQua_KhaiThac_Cargo_VU_Thang${String(now.getMonth() + 1).padStart(2, '0')}_${now.getFullYear()}.xlsx`;
                    XLSX.writeFile(wb, fileName);
                    showToast("Đã tải xuống file Excel (.xlsx) thành công!");
                } catch (err) {
                    console.error("Export Excel error:", err);
                    showReportModal({
                        title: 'Lỗi xuất file Excel',
                        message: `<div class="p-3 bg-red-50 text-red-700 border border-red-200 rounded-xl font-mono text-xs">${err.message}</div>`,
                        type: 'error'
                    });
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                }
            }, 300);
        }

