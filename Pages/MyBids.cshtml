                    </a>
                    <a href="06-MyBids.html" class="px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 font-semibold flex items-center gap-1.5">
                        <i class="fa-solid fa-clock-rotate-left text-xs"></i> Lịch sử thầu
                    </a>
                    <a href="07-WonAuction.html" class="px-3 py-1.5 rounded-lg text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-trophy text-xs"></i> Thắng thầu
                    </a>
                </nav>
            </div>
            <div class="flex items-center gap-1.5 sm:gap-3">
