                            <th class="py-3.5 px-5">Tải trọng đăng ký</th>
                            <th class="py-3.5 px-5">Tổng tiền thầu (VND)</th>
                            <th class="py-3.5 px-5">Thời gian đặt</th>
                            <th class="py-3.5 px-5">Trạng thái</th>
                        </tr>
