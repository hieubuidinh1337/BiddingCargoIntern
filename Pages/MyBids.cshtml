        </a>
                <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
                    <a href="02-Dashboard.html" class="px-3 py-1.5 rounded-lg text-gray-600 hover:text-blue-600 hover:bg-gray-50 transition flex items-center gap-1.5">
